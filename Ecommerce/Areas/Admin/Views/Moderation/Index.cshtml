@model Ecommerce.Models.ViewModels.ModerationVM
@{
    ViewData["Title"] = "Moderation";
}

<div>
    <div class="flex gap-2 mb-6 border-b border-surface-variant">
        <button onclick="showTab('comments')" id="tab-btn-comments"
                class="px-6 py-3 font-label-caps text-label-caps border-b-2 border-primary-container text-on-surface">
            Product Comments (@Model.PendingComments.Count)
        </button>
        <button onclick="showTab('testimonials')" id="tab-btn-testimonials"
                class="px-6 py-3 font-label-caps text-label-caps border-b-2 border-transparent text-tertiary">
            Testimonials (@Model.PendingTestimonials.Count)
        </button>
    </div>

    <!-- Comments Tab -->
    <div id="tab-comments" class="flex flex-col gap-4">
        @if (Model.PendingComments != null && Model.PendingComments.Any())
        {
            @foreach (var c in Model.PendingComments)
            {
                <div class="bg-surface-container-lowest border border-surface-variant rounded p-6">
                    <div class="flex justify-between items-start mb-3">
                        <div>
                            <p class="font-body-md text-on-surface font-medium">@c.UserFullName</p>
                            <p class="font-label-caps text-label-caps text-tertiary">on "@c.ProductName" &middot; @c.CreatedAt.ToString("MMM d, yyyy")</p>
                        </div>
                        <div class="flex items-center gap-1 text-primary-container">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <span class="material-symbols-outlined text-[16px]" style="font-variation-settings: 'FILL' @(i <= c.Rating ? 1 : 0);">star</span>
                            }
                        </div>
                    </div>
                    <p class="font-body-md text-body-md text-on-surface mb-4">@c.Text</p>
                    <div class="flex gap-3">
                        <form asp-area="Admin" asp-controller="Moderation" asp-action="ApproveComment" method="post">
                            <input type="hidden" name="id" value="@c.Id" />
                            <button type="submit" class="border border-green-700 text-green-700 font-label-caps text-label-caps px-5 py-2 rounded hover:bg-green-50 transition-colors">Approve</button>
                        </form>
                        <form asp-area="Admin" asp-controller="Moderation" asp-action="RejectComment" method="post">
                            <input type="hidden" name="id" value="@c.Id" />
                            <button type="submit" class="border border-primary-container text-primary-container font-label-caps text-label-caps px-5 py-2 rounded hover:bg-red-50 transition-colors">Reject</button>
                        </form>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="text-center py-16 bg-surface-container-lowest border border-surface-variant rounded">
                <span class="material-symbols-outlined text-tertiary text-[32px] mb-2 block">rate_review</span>
                <p class="font-body-md text-body-md text-tertiary">No pending comments to review.</p>
            </div>
        }
    </div>

    <!-- Testimonials Tab -->
    <div id="tab-testimonials" class="flex-col gap-4 hidden">
        @if (Model.PendingTestimonials != null && Model.PendingTestimonials.Any())
        {
            @foreach (var t in Model.PendingTestimonials)
            {
                <div class="bg-surface-container-lowest border border-surface-variant rounded p-6">
                    <p class="font-body-md text-on-surface font-medium mb-1">@t.UserFullName</p>
                    <p class="font-label-caps text-label-caps text-tertiary mb-3">@t.CreatedAt.ToString("MMM d, yyyy")</p>
                    <p class="font-body-md text-body-md text-on-surface mb-4">&ldquo;@t.Text&rdquo;</p>
                    <div class="flex gap-3">
                        <form asp-area="Admin" asp-controller="Moderation" asp-action="ApproveTestimonial" method="post">
                            <input type="hidden" name="id" value="@t.Id" />
                            <button type="submit" class="border border-green-700 text-green-700 font-label-caps text-label-caps px-5 py-2 rounded hover:bg-green-50 transition-colors">Approve</button>
                        </form>
                        <form asp-area="Admin" asp-controller="Moderation" asp-action="RejectTestimonial" method="post">
                            <input type="hidden" name="id" value="@t.Id" />
                            <button type="submit" class="border border-primary-container text-primary-container font-label-caps text-label-caps px-5 py-2 rounded hover:bg-red-50 transition-colors">Reject</button>
                        </form>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="text-center py-16 bg-surface-container-lowest border border-surface-variant rounded">
                <span class="material-symbols-outlined text-tertiary text-[32px] mb-2 block">forum</span>
                <p class="font-body-md text-body-md text-tertiary">No pending testimonials to review.</p>
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
    function showTab(tab) {
        document.getElementById('tab-comments').classList.toggle('hidden', tab !== 'comments');
        document.getElementById('tab-comments').classList.toggle('flex', tab === 'comments');
        document.getElementById('tab-testimonials').classList.toggle('hidden', tab !== 'testimonials');
        document.getElementById('tab-testimonials').classList.toggle('flex', tab === 'testimonials');

        document.getElementById('tab-btn-comments').classList.toggle('border-primary-container', tab === 'comments');
        document.getElementById('tab-btn-comments').classList.toggle('text-on-surface', tab === 'comments');
        document.getElementById('tab-btn-comments').classList.toggle('border-transparent', tab !== 'comments');
        document.getElementById('tab-btn-comments').classList.toggle('text-tertiary', tab !== 'comments');

        document.getElementById('tab-btn-testimonials').classList.toggle('border-primary-container', tab === 'testimonials');
        document.getElementById('tab-btn-testimonials').classList.toggle('text-on-surface', tab === 'testimonials');
        document.getElementById('tab-btn-testimonials').classList.toggle('border-transparent', tab !== 'testimonials');
        document.getElementById('tab-btn-testimonials').classList.toggle('text-tertiary', tab !== 'testimonials');
    }
</script>
}
