@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>@ViewData["Title"] - Admin - Gym Gear & Activewear</title>
<partial name="_TailwindHead" />
@await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-background text-on-background font-body-md antialiased flex"
      data-toast-message="@TempData["ToastMessage"]" data-toast-type="@TempData["ToastType"]">

<!-- Sidebar -->
<nav class="bg-inverse-surface fixed left-0 top-0 h-full w-[280px] shadow-md flex flex-col py-6 z-40 hidden md:flex">
    <div class="px-6 mb-8 flex flex-col gap-4">
        <h1 class="font-headline-md text-headline-md font-bold text-on-primary">GYM<span style="color:#ff8a8a;">GEAR</span> Admin</h1>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full overflow-hidden bg-tertiary-container flex items-center justify-center">
                <span class="material-symbols-outlined text-on-primary">person</span>
            </div>
            <div>
                <div class="font-label-caps text-label-caps text-on-primary">@(User.Identity != null && User.Identity.IsAuthenticated ? User.Identity.Name : "Admin")</div>
                <div class="font-label-caps text-label-caps text-tertiary-fixed-dim">System Controller</div>
            </div>
        </div>
    </div>
    <div class="flex-1 overflow-y-auto">
        <ul class="flex flex-col gap-1">
            <li>
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
                   class="flex items-center gap-3 px-4 py-3 font-label-caps text-label-caps border-l-4 transition-all duration-200 @(currentController == "Dashboard" ? "text-on-primary bg-primary border-primary" : "text-tertiary-fixed-dim hover:text-on-primary hover:bg-tertiary-container border-transparent")">
                    <span class="material-symbols-outlined">dashboard</span> Dashboard
                </a>
            </li>
            <li>
                <a asp-area="Admin" asp-controller="Category" asp-action="Index"
                   class="flex items-center gap-3 px-4 py-3 font-label-caps text-label-caps border-l-4 transition-all duration-200 @(currentController == "Category" ? "text-on-primary bg-primary border-primary" : "text-tertiary-fixed-dim hover:text-on-primary hover:bg-tertiary-container border-transparent")">
                    <span class="material-symbols-outlined">category</span> Categories
                </a>
            </li>
            <li>
                <a href="#" class="flex items-center gap-3 text-tertiary-fixed-dim hover:text-on-primary px-4 py-3 font-label-caps text-label-caps hover:bg-tertiary-container transition-all duration-200 border-l-4 border-transparent">
                    <span class="material-symbols-outlined">inventory_2</span> Products
                </a>
            </li>
            <li>
                <a href="#" class="flex items-center gap-3 text-tertiary-fixed-dim hover:text-on-primary px-4 py-3 font-label-caps text-label-caps hover:bg-tertiary-container transition-all duration-200 border-l-4 border-transparent">
                    <span class="material-symbols-outlined">shopping_bag</span> Orders
                </a>
            </li>
            <li>
                <a href="#" class="flex items-center gap-3 text-tertiary-fixed-dim hover:text-on-primary px-4 py-3 font-label-caps text-label-caps hover:bg-tertiary-container transition-all duration-200 border-l-4 border-transparent">
                    <span class="material-symbols-outlined">group</span> Users
                </a>
            </li>
            <li>
                <a href="#" class="flex items-center gap-3 text-tertiary-fixed-dim hover:text-on-primary px-4 py-3 font-label-caps text-label-caps hover:bg-tertiary-container transition-all duration-200 border-l-4 border-transparent">
                    <span class="material-symbols-outlined">gavel</span> Moderation
                </a>
            </li>
        </ul>
    </div>
</nav>

<!-- Main Content Area -->
<main class="flex-1 md:ml-[280px] h-full overflow-y-auto bg-background w-full">
    <header class="bg-surface border-b border-outline-variant sticky top-0 z-30 px-margin-mobile md:px-margin-desktop py-4 flex justify-between items-center h-16">
        <div class="flex items-center gap-4">
            <button class="md:hidden text-on-surface"><span class="material-symbols-outlined">menu</span></button>
            <h2 class="font-headline-sm text-headline-sm text-on-surface hidden md:block">@ViewData["Title"]</h2>
        </div>
        <div class="flex items-center gap-4">
            <span class="material-symbols-outlined text-on-surface cursor-pointer hover:text-primary transition-colors">notifications</span>
        </div>
    </header>
    <div class="p-margin-mobile md:p-margin-desktop max-w-container-max mx-auto space-y-gutter">
        @RenderBody()
    </div>
</main>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
