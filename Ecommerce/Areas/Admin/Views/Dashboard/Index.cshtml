@using System.Text.Json
@model Ecommerce.Models.ViewModels.DashboardVM

@{
    ViewData["Title"] = "Overview";
    var chartLabels = JsonSerializer.Serialize(Model.OrderChartLabels);
    var chartValues = JsonSerializer.Serialize(Model.OrderChartValues);
}

<!-- Stat Cards -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-gutter">

    <!-- Users -->
    <div class="bg-surface-container-lowest p-6 rounded-sm border border-outline-variant hover:border-primary transition-colors duration-200 shadow-sm">
        <div class="flex justify-between items-start">
            <div>
                <p class="font-label-caps text-label-caps text-tertiary uppercase">Total Users</p>
                <h3 class="font-headline-md text-headline-md text-on-surface mt-1 font-bold">@Model.TotalUsers</h3>
            </div>
            <div class="w-10 h-10 rounded-sm bg-surface-variant flex items-center justify-center">
                <span class="material-symbols-outlined text-on-surface">group</span>
            </div>
        </div>
    </div>

    <!-- Products -->
    <div class="bg-surface-container-lowest p-6 rounded-sm border border-outline-variant hover:border-primary transition-colors duration-200 shadow-sm">
        <div class="flex justify-between items-start">
            <div>
                <p class="font-label-caps text-label-caps text-tertiary uppercase">Total Products</p>
                <h3 class="font-headline-md text-headline-md text-on-surface mt-1 font-bold">@Model.TotalProducts</h3>
            </div>
            <div class="w-10 h-10 rounded-sm bg-surface-variant flex items-center justify-center">
                <span class="material-symbols-outlined text-on-surface">inventory_2</span>
            </div>
        </div>
    </div>

    <!-- Categories -->
    <div class="bg-surface-container-lowest p-6 rounded-sm border border-outline-variant hover:border-primary transition-colors duration-200 shadow-sm">
        <div class="flex justify-between items-start">
            <div>
                <p class="font-label-caps text-label-caps text-tertiary uppercase">Total Categories</p>
                <h3 class="font-headline-md text-headline-md text-on-surface mt-1 font-bold">@Model.TotalCategories</h3>
            </div>
            <div class="w-10 h-10 rounded-sm bg-surface-variant flex items-center justify-center">
                <span class="material-symbols-outlined text-on-surface">category</span>
            </div>
        </div>
    </div>

    <!-- Orders -->
    <div class="bg-surface-container-lowest p-6 rounded-sm border border-outline-variant hover:border-primary transition-colors duration-200 shadow-sm">
        <div class="flex justify-between items-start">
            <div>
                <p class="font-label-caps text-label-caps text-tertiary uppercase">Total Orders</p>
                <h3 class="font-headline-md text-headline-md text-on-surface mt-1 font-bold">@Model.TotalOrders</h3>
            </div>
            <div class="w-10 h-10 rounded-sm bg-primary/10 flex items-center justify-center">
                <span class="material-symbols-outlined text-primary">shopping_bag</span>
            </div>
        </div>
    </div>
</div>

<!-- Chart and Recent Orders -->
<div class="grid grid-cols-1 xl:grid-cols-3 gap-6 mt-6">

    <!-- Orders Chart -->
    <div class="xl:col-span-2 bg-surface-container-lowest border border-outline-variant rounded-sm shadow-sm p-6">
        <div class="flex items-start justify-between mb-6">
            <div>
                <h2 class="font-headline-sm text-headline-sm text-on-surface font-bold">Orders Overview</h2>
                <p class="font-body-md text-sm text-tertiary mt-1">Orders placed during the last 7 days</p>
            </div>
            <div class="w-10 h-10 rounded-sm bg-primary/10 flex items-center justify-center">
                <span class="material-symbols-outlined text-primary">monitoring</span>
            </div>
        </div>
        <div class="relative w-full h-[320px]">
            <canvas id="ordersChart"></canvas>
        </div>
    </div>

    <!-- Recent Orders -->
    <div class="bg-surface-container-lowest border border-outline-variant rounded-sm shadow-sm overflow-hidden flex flex-col">
        <div class="p-6 border-b border-outline-variant flex items-center justify-between">
            <div>
                <h2 class="font-headline-sm text-headline-sm text-on-surface font-bold">Recent Orders</h2>
                <p class="font-body-md text-sm text-tertiary mt-1">Latest customer orders</p>
            </div>
            <a asp-area="Admin" asp-controller="Order" asp-action="Index" class="font-label-caps text-label-caps text-primary hover:underline">
                VIEW ALL
            </a>
        </div>

        @if (Model.RecentOrders != null && Model.RecentOrders.Any())
        {
            <div class="divide-y divide-outline-variant overflow-y-auto flex-1">
                @foreach (var order in Model.RecentOrders)
                {
                    <a asp-area="Admin" asp-controller="Order" asp-action="Details" asp-route-id="@order.Id"
                       class="flex items-center justify-between gap-4 p-4 hover:bg-surface-variant/50 transition-colors group">
                        <div class="min-w-0">
                            <p class="font-body-md text-on-surface font-bold group-hover:text-primary transition-colors">
                                #ORD-@order.Id.ToString("D4")
                            </p>
                            <p class="font-body-md text-sm text-tertiary truncate">@order.CustomerName</p>
                        </div>
                        <div class="text-right shrink-0">
                            <p class="font-price-display text-[15px] text-on-surface">@order.Total.ToString("C")</p>
                            @{
                                var statusClass = order.Status switch
                                {
                                    "Completed" => "text-green-500",
                                    "Cancelled" => "text-tertiary",
                                    "CancellationRequested" => "text-amber-500",
                                    _ => "text-primary"
                                };
                            }
                            <p class="font-label-caps text-label-caps @statusClass">@order.Status</p>
                        </div>
                    </a>
                }
            </div>
        }
        else
        {
            <div class="text-center py-16 px-6 flex flex-col items-center justify-center flex-1">
                <span class="material-symbols-outlined text-tertiary text-[32px] mb-2 block">shopping_bag</span>
                <p class="font-body-md text-body-md text-tertiary">No orders yet.</p>
            </div>
        }
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const ordersChartElement = document.getElementById("ordersChart");
    const orderLabels = @Html.Raw(chartLabels);
    const orderValues = @Html.Raw(chartValues);

    const isDark = document.documentElement.classList.contains('dark');
    const gridColor = isDark ? 'rgba(255, 255, 255, 0.08)' : 'rgba(0, 0, 0, 0.06)';
    const tickColor = isDark ? '#9ca3af' : '#6b7280';

    new Chart(ordersChartElement, {
        type: "line",
        data: {
            labels: orderLabels,
            datasets: [{
                label: "Orders",
                data: orderValues,
                borderColor: "#e11d48",
                backgroundColor: "rgba(225, 29, 72, 0.12)",
                borderWidth: 3,
                pointBackgroundColor: "#e11d48",
                pointBorderColor: isDark ? "#1e1e1e" : "#ffffff",
                pointBorderWidth: 2,
                pointRadius: 5,
                pointHoverRadius: 7,
                fill: true,
                tension: 0.35
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            interaction: { intersect: false, mode: "index" },
            plugins: {
                legend: { display: false },
                tooltip: {
                    backgroundColor: "#18181b",
                    titleColor: "#ffffff",
                    bodyColor: "#ffffff",
                    padding: 12,
                    displayColors: false,
                    callbacks: {
                        label: function(context) {
                            return context.parsed.y === 1 ? "1 order" : context.parsed.y + " orders";
                        }
                    }
                }
            },
            scales: {
                x: {
                    grid: { display: false },
                    border: { display: false },
                    ticks: { color: tickColor, font: { size: 12 } }
                },
                y: {
                    beginAtZero: true,
                    ticks: { precision: 0, stepSize: 1, color: tickColor },
                    grid: { color: gridColor },
                    border: { display: false }
                }
            }
        }
    });
</script>
