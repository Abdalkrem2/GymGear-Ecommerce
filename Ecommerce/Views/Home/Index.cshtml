@using System.Globalization
@model Ecommerce.Models.ViewModels.HomeVM

@{
    ViewData["Title"] = "Home Page";
}

<!-- 1. HERO VIDEO SECTION (Primary Video Banner) -->
<section class="js-hero-section relative w-full h-[85vh] min-h-[600px] flex items-center justify-center overflow-hidden bg-black">
    <!-- Video Background -->
    <video autoplay loop muted playsinline class="absolute top-0 left-0 w-full h-full object-cover z-0 opacity-80">
        <source src="~/uploads/videos/AUGUST_SEASONAL_MENS_WEB_8x3.mp4" type="video/mp4" />
    </video>

    <!-- Hero Content -->
    <div class="relative z-20 text-center px-4 md:px-8 flex flex-col items-center mt-16 max-w-4xl mx-auto">
        <h1 class="text-white text-5xl md:text-7xl lg:text-8xl font-black uppercase tracking-tighter mb-4">
            Unleash Your <span class="text-primary">Edge</span>
        </h1>
        <p class="text-white/90 text-lg md:text-xl font-medium mb-8 max-w-xl">
            The new standard in performance wear. Engineered to breathe, stretch, and move with you.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 w-full sm:w-auto">
            <a asp-controller="Product" asp-action="Index" asp-route-category="mens" class="bg-white text-black font-bold uppercase tracking-widest px-8 py-4 rounded-sm hover:bg-gray-200 transition-colors w-full sm:w-auto text-center">
                Shop Men
            </a>
            <a asp-controller="Product" asp-action="Index" asp-route-category="womens" class="bg-white text-black font-bold uppercase tracking-widest px-8 py-4 rounded-sm hover:bg-gray-200 transition-colors w-full sm:w-auto text-center">
                Shop Women
            </a>
        </div>
    </div>
</section>

<!-- NEW ARRIVALS (4-Product Sliding Carousel with Enlarged Cards & Arrows) -->
<section class="w-full py-12 md:py-16 bg-surface overflow-x-hidden relative group/section" id="newArrivalsSection">
    <div class="w-full px-4 md:px-8">
        <div class="flex justify-between items-end mb-8">
            <div>
                <span class="text-primary font-bold tracking-[0.2em] uppercase text-xs mb-1.5 block">Latest Drops</span>
                <h2 class="text-2xl md:text-4xl font-black text-on-surface uppercase tracking-tight">New Arrivals</h2>
            </div>
            <div class="flex items-center gap-3">
                <a asp-controller="Product" asp-action="Index" class="text-xs md:text-sm font-bold border-b border-on-surface text-on-surface uppercase pb-1 hover:text-primary hover:border-primary transition-colors tracking-wider mr-2 hidden sm:inline-block">View All</a>
                <button type="button" 
                        id="prevNewArrivalsBtn" 
                        class="w-10 h-10 md:w-11 md:h-11 rounded-full border border-outline-variant bg-surface hover:bg-surface-variant hover:border-primary text-on-surface flex items-center justify-center transition-all focus:outline-none shadow-sm group"
                        aria-label="Previous Products">
                    <span class="material-symbols-outlined text-[20px] text-current group-hover:text-primary transition-colors">arrow_back</span>
                </button>
                <button type="button" 
                        id="nextNewArrivalsBtn" 
                        class="w-10 h-10 md:w-11 md:h-11 rounded-full border border-outline-variant bg-surface hover:bg-surface-variant hover:border-primary text-on-surface flex items-center justify-center transition-all focus:outline-none shadow-sm group"
                        aria-label="Next Products">
                    <span class="material-symbols-outlined text-[20px] text-current group-hover:text-primary transition-colors">arrow_forward</span>
                </button>
            </div>
        </div>

        <!-- Scrollable 4-Item Container (Aspect-Ratio Correct, Enlarged) -->
        <div id="newArrivalsCarousel" class="flex overflow-x-auto snap-x snap-mandatory gap-4 md:gap-6 pb-4 hide-scrollbar scroll-smooth">
            @if (Model.NewArrivals != null && Model.NewArrivals.Any())
            {
                @foreach (var product in Model.NewArrivals)
                {
                    <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id" 
                       class="carousel-card snap-start shrink-0 w-[80vw] sm:w-[46vw] md:w-[calc(33.333%-1rem)] lg:w-[calc(25%-1.125rem)] flex flex-col group cursor-pointer block bg-surface rounded-sm">
                        <!-- Enlarged, aspect-ratio correct image box without cutting parts of image -->
                        <div class="relative w-full aspect-[3/4] bg-surface-container-low border border-outline-variant/60 rounded-sm overflow-hidden mb-3.5 flex items-center justify-center p-4">
                            @if (!string.IsNullOrEmpty(product.MainImagePath))
                            {
                                <img src="@product.MainImagePath" 
                                     alt="@product.Name" 
                                     class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-500" 
                                     loading="lazy" />
                            }
                            else
                            {
                                <div class="w-full h-full flex items-center justify-center text-tertiary font-label-caps text-xs">
                                    NO IMAGE
                                </div>
                            }
                        </div>
                        <div class="flex items-center justify-between gap-2 mb-1">
                            <span class="text-[11px] font-semibold tracking-wider text-tertiary uppercase truncate">
                                @product.CategoryName
                            </span>
                            <div class="flex text-primary text-[13px] shrink-0">
                                @for (int i = 0; i < 5; i++)
                                {
                                    <span class="material-symbols-outlined text-[13px]" style="font-variation-settings: 'FILL' 1;">star</span>
                                }
                            </div>
                        </div>
                        <h3 class="font-bold text-sm md:text-base text-on-surface group-hover:text-primary transition-colors leading-snug mb-1.5 truncate">
                            @product.Name
                        </h3>
                        <span class="font-body-md text-sm md:text-base font-semibold text-on-surface tracking-tight">
                            @product.Price.ToString("C", new CultureInfo("en-US"))
                        </span>
                    </a>
                }
            }
            else
            {
                <p class="text-tertiary text-sm py-4">No new arrivals available at the moment.</p>
            }
        </div>
    </div>
</section>

<!-- 4. SECOND VIDEO SEPARATOR (Campaign Video: ES_CAMPAIGN_DESKTOP_BANNER) -->
<section class="relative w-full h-[60vh] min-h-[460px] md:h-[70vh] md:min-h-[540px] flex items-center justify-center overflow-hidden bg-black border-y border-outline-variant/20">
    <!-- Video Background -->
    <video autoplay loop muted playsinline class="absolute inset-0 w-full h-full object-cover z-0 opacity-70">
        <source src="~/uploads/videos/ES_CAMPAIGN_DESKTOP_BANNER.mp4" type="video/mp4" />
    </video>

    <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/50 to-black/80 z-10"></div>

    <!-- Separator Content -->
    <div class="relative z-20 text-center px-4 md:px-8 flex flex-col items-center max-w-4xl mx-auto">
        <span class="text-primary font-bold tracking-[0.25em] uppercase text-xs md:text-sm mb-3 block">
            The Autumn Drop
        </span>
        <h2 class="text-white text-4xl md:text-6xl lg:text-7xl font-black uppercase tracking-tighter mb-5">
            Engineered For The <span class="text-primary">Relentless</span>
        </h2>
        <p class="text-white/90 text-base md:text-xl font-medium mb-8 max-w-2xl leading-relaxed">
            Zero compromises on fabric durability, moisture control, or range of motion. Built to withstand your heaviest training sessions.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 w-full sm:w-auto">
            <a asp-controller="Product" asp-action="Index" class="bg-primary text-on-primary font-bold uppercase tracking-widest px-10 py-4 rounded-sm hover:bg-primary/90 transition-all flex items-center justify-center gap-2 group shadow-lg">
                Explore The Campaign
                <span class="material-symbols-outlined text-[20px] transform group-hover:translate-x-1 transition-transform">arrow_forward</span>
            </a>
            <a asp-controller="Home" asp-action="About" class="bg-white/10 backdrop-blur-sm border border-white/30 text-white font-bold uppercase tracking-widest px-8 py-4 rounded-sm hover:bg-white/20 transition-colors text-center">
