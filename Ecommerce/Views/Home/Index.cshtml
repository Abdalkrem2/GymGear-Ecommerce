                <div class="relative w-full aspect-[4/5] bg-surface-variant overflow-hidden rounded-sm mb-4">
                    <img src="https://images.unsplash.com/photo-1521572267360-ee0c2909d518?auto=format&fit=crop&w=800&q=80" 
                         alt="Legacy Stringer Tank" 
                         class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
