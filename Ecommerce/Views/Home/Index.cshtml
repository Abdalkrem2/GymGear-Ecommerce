@{
    ViewData["Title"] = "Home Page";
}

<!-- HERO VIDEO SECTION -->
<section class="relative w-full h-[85vh] min-h-[600px] flex items-center justify-center overflow-hidden bg-black">
    <!-- Video Background -->
    <video autoplay loop muted playsinline class="absolute top-0 left-0 w-full h-full object-cover z-0 opacity-80">
        <source src="~/uploads/videos/AUGUST_SEASONAL_MENS_WEB_8x3.mp4" type="video/mp4" />
    </video>

    <!-- Hero Content -->
    <div class="relative z-20 text-center px-4 flex flex-col items-center mt-16">
        <h1 class="text-white text-5xl md:text-7xl font-black uppercase tracking-tighter mb-4">
            Unleash Your <span class="text-primary">Edge</span>
        </h1>
        <p class="text-white/90 text-lg md:text-xl font-medium mb-8 max-w-xl">
            The new standard in performance wear. Engineered to breathe, stretch, and move with you.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 w-full sm:w-auto">
            <a asp-controller="Product" asp-action="Index" asp-route-category="mens" class="bg-white text-black font-bold uppercase tracking-widest px-8 py-4 rounded-sm hover:bg-gray-200 transition-colors w-full sm:w-auto">
                Shop Men
            </a>
            <a asp-controller="Product" asp-action="Index" asp-route-category="womens" class="bg-white text-black font-bold uppercase tracking-widest px-8 py-4 rounded-sm hover:bg-gray-200 transition-colors w-full sm:w-auto">
                Shop Women
            </a>
        </div>
    </div>
</section>

<!-- NEW ARRIVALS (Mobile Horizontal Scroll) -->
<section class="w-full py-16 bg-surface">
    <div class="max-w-[1280px] mx-auto px-4 md:px-margin-desktop">
        <div class="flex justify-between items-end mb-8">
            <h2 class="text-2xl md:text-3xl font-black text-on-surface uppercase tracking-tight">New Arrivals</h2>
            <a asp-controller="Product" asp-action="Index" class="text-sm font-bold border-b border-on-surface text-on-surface uppercase pb-1 hover:text-primary hover:border-primary transition-colors">View All</a>
        </div>

        <!-- Scrollable Container -->
        <div class="flex overflow-x-auto snap-x snap-mandatory gap-4 md:gap-6 pb-4 hide-scrollbar">
<!-- Product 1 -->
            <a asp-controller="Product" asp-action="Details" asp-route-id="1" class="snap-start shrink-0 w-[75vw] sm:w-[45vw] md:w-[calc(25%-1.125rem)] flex flex-col group cursor-pointer block">
                <div class="relative w-full aspect-[4/5] bg-surface-variant overflow-hidden rounded-sm mb-4">
                    <img src="[https://images.unsplash.com/photo-1574680096145-d05b474e2155?auto=format&fit=crop&w=800&q=80](https://images.unsplash.com/photo-1574680096145-d05b474e2155?auto=format&fit=crop&w=800&q=80)" 
                         alt="Onyx Seamless T-Shirt" 
                         class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                </div>
                <h3 class="font-bold text-on-surface text-sm uppercase mb-1 group-hover:text-primary transition-colors">Onyx Seamless T-Shirt</h3>
                <p class="text-tertiary text-sm mb-2">Charcoal / Black</p>
                <span class="font-medium text-on-surface">$45.00</span>
            </a>

            <!-- Product 2 -->
            <a asp-controller="Product" asp-action="Details" asp-route-id="2" class="snap-start shrink-0 w-[75vw] sm:w-[45vw] md:w-[calc(25%-1.125rem)] flex flex-col group cursor-pointer block">
                <div class="relative w-full aspect-[4/5] bg-surface-variant overflow-hidden rounded-sm mb-4">
                    <img src="https://images.unsplash.com/photo-1506629082955-511b1aa562c8?auto=format&fit=crop&w=800&q=80" 
                         alt="Arrival 5'' Performance Shorts" 
                         class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                </div>
                <h3 class="font-bold text-on-surface text-sm uppercase mb-1 group-hover:text-primary transition-colors">Arrival 5" Shorts</h3>
                <p class="text-tertiary text-sm mb-2">Pitch Black</p>
                <span class="font-medium text-on-surface">$38.00</span>
            </a>

            <!-- Product 3 -->
            <a asp-controller="Product" asp-action="Details" asp-route-id="3" class="snap-start shrink-0 w-[75vw] sm:w-[45vw] md:w-[calc(25%-1.125rem)] flex flex-col group cursor-pointer block">
                <div class="relative w-full aspect-[4/5] bg-surface-variant overflow-hidden rounded-sm mb-4">
                    <img src="https://images.unsplash.com/photo-1518611012118-696072aa579a?auto=format&fit=crop&w=800&q=80" 
                         alt="Adapt Seamless Crop Top" 
                         class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                </div>
                <h3 class="font-bold text-on-surface text-sm uppercase mb-1 group-hover:text-primary transition-colors">Adapt Seamless Crop Top</h3>
                <p class="text-tertiary text-sm mb-2">Base Green</p>
                <span class="font-medium text-on-surface">$40.00</span>
            </a>

            <!-- Product 4 -->
            <a asp-controller="Product" asp-action="Details" asp-route-id="4" class="snap-start shrink-0 w-[75vw] sm:w-[45vw] md:w-[calc(25%-1.125rem)] flex flex-col group cursor-pointer block">
                <div class="relative w-full aspect-[4/5] bg-surface-variant overflow-hidden rounded-sm mb-4">
                    <img src="https://images.unsplash.com/photo-1543163521-1bf539c55dd2?auto=format&fit=crop&w=800&q=80" 
                         alt="Apex High-Rise Leggings" 
                         class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                </div>
                <h3 class="font-bold text-on-surface text-sm uppercase mb-1 group-hover:text-primary transition-colors">Apex High-Rise Leggings</h3>
                <p class="text-tertiary text-sm mb-2">Graphite Marl</p>
                <span class="font-medium text-on-surface">$60.00</span>
            </a>
        </div>
    </div>
</section>

<!-- TRENDING SECTION -->
<section class="w-full py-4 md:py-16 bg-surface-container-lowest border-t border-outline-variant/30">
    <div class="max-w-[1280px] mx-auto px-4 md:px-margin-desktop text-center">
        <h2 class="text-3xl md:text-5xl font-black text-on-surface uppercase tracking-tight mb-8 md:mb-12">Trending Now</h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">

            <!-- Trending Block 1: Accessories -->
            <a asp-controller="Product" asp-action="Index" class="relative h-[400px] md:h-[550px] rounded-sm overflow-hidden flex items-end p-6 md:p-10 group cursor-pointer block">
                <img src="https://images.unsplash.com/photo-1517838277536-f5f99be501cd?auto=format&fit=crop&w=1200&q=80" 
                     alt="Lifting Equipment" 
                     class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 z-0" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent z-10"></div>
                <div class="relative z-20 w-full text-left">
                    <h3 class="text-white text-3xl md:text-4xl font-black uppercase mb-3 tracking-tight">Lifting Accessories</h3>
                    <span class="inline-block bg-white text-black font-bold uppercase text-xs tracking-wider px-6 py-3 rounded-sm hover:bg-gray-200 transition-colors">Shop Equipment</span>
                </div>
            </a>

            <!-- Trending Block 2: Rest Day / Recovery -->
            <a asp-controller="Product" asp-action="Index" class="relative h-[400px] md:h-[550px] rounded-sm overflow-hidden flex items-end p-6 md:p-10 group cursor-pointer block">
                <img src="https://images.unsplash.com/photo-1556817411-31ae72fa3ea0?auto=format&fit=crop&w=1200&q=80" 
                     alt="Rest & Recovery" 
                     class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 z-0" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent z-10"></div>
                <div class="relative z-20 w-full text-left">
                    <h3 class="text-white text-3xl md:text-4xl font-black uppercase mb-3 tracking-tight">Recovery &amp; Rest</h3>
                    <span class="inline-block bg-white text-black font-bold uppercase text-xs tracking-wider px-6 py-3 rounded-sm hover:bg-gray-200 transition-colors">Shop Rest Day</span>
                </div>
            </a>

        </div>
    </div>
</section>

<!-- MOST FAVORITES (Mobile Horizontal Scroll) -->
