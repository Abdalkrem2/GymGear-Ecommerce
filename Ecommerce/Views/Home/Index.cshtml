                </div>
                <h3 class="font-bold text-on-surface text-sm uppercase mb-1 group-hover:text-primary transition-colors">Crest Pullover Hoodie</h3>
                <p class="text-tertiary text-sm mb-2">Olive Green</p>
                <span class="font-medium text-on-surface">$55.00</span>
            </a>

            <!-- Favorite 4 -->
            <a asp-controller="Product" asp-action="Details" asp-route-id="8" class="snap-start shrink-0 w-[75vw] sm:w-[45vw] md:w-[calc(25%-1.125rem)] flex flex-col group cursor-pointer block">
                <div class="relative w-full aspect-[4/5] bg-surface-variant overflow-hidden rounded-sm mb-4">
                    <img src="https://images.unsplash.com/photo-1620799140408-edc6dcb6d633?auto=format&fit=crop&w=800&q=80" 
                         alt="Rest Day Knit Joggers" 
                         class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                </div>
                <h3 class="font-bold text-on-surface text-sm uppercase mb-1 group-hover:text-primary transition-colors">Rest Day Knit Joggers</h3>
