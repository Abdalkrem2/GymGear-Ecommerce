@model Ecommerce.Models.ViewModels.HomeVM
@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section -->
<section class="relative w-full bg-surface-container-low overflow-hidden flex flex-col lg:flex-row items-center justify-center min-h-[70vh] px-margin-mobile md:px-margin-desktop py-section-padding">
    <div class="w-full lg:w-1/2 flex flex-col items-start justify-center z-10 max-w-[600px]">
        <span class="font-label-caps text-label-caps text-primary-container mb-4 block">NEW SEASON DROP</span>
        <h1 class="font-display-lg text-display-lg text-on-surface mb-6 leading-tight">
            DISCOVER YOUR <br />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary-container to-surface-tint">SPORTY EDGE</span>
        </h1>
        <p class="font-body-lg text-body-lg text-tertiary mb-10 max-w-md">
            Get the best sports apparel with the best offer that you can afford. Available for worldwide shipping and free delivery.
        </p>
        <a asp-controller="Product" asp-action="Index" class="inline-flex items-center justify-center bg-primary-container text-on-primary font-label-caps text-label-caps px-10 py-5 rounded-sm hover:bg-surface-tint transition-all hover:shadow-[0_4px_12px_rgba(211,30,50,0.3)]">
            SHOP NOW
            <span class="material-symbols-outlined ml-2 text-[18px]">arrow_forward</span>
        </a>
    </div>
    <div class="w-full lg:w-1/2 relative mt-12 lg:mt-0 flex justify-center lg:justify-end items-center h-[360px] lg:h-[500px]">
        <div class="absolute w-[80%] h-[80%] bg-primary-container rounded-full opacity-10 blur-3xl -z-10"></div>
        <div class="w-full h-full max-w-[500px] bg-surface-container-lowest border border-outline-variant rounded-sm flex items-center justify-center text-tertiary font-label-caps text-label-caps">
            PRODUCT IMAGE
        </div>
    </div>
</section>

<!-- Category Strip (dynamic) -->
<section class="w-full bg-surface py-10 border-b border-outline-variant">
    <div class="max-w-[1280px] mx-auto px-4 md:px-margin-desktop flex flex-wrap justify-center md:justify-between items-center gap-8">
        @if (Model.Categories != null && Model.Categories.Any())
        {
            @foreach (var cat in Model.Categories.Take(5))
            {
                <span class="inline-block text-center font-headline-md text-headline-md font-bold tracking-widest text-tertiary hover:text-primary-container transition-colors cursor-pointer">
                    @cat.Name.ToUpper()
                </span>
            }
        }
        else
        {
            <span class="font-label-caps text-label-caps text-tertiary text-center">
                Categories will appear here once added from the admin dashboard.
            </span>
        }
    </div>
</section>

<!-- Promo Banners -->
<section class="w-full max-w-[1280px] mx-auto px-margin-mobile md:px-margin-desktop py-section-padding grid grid-cols-1 md:grid-cols-2 gap-gutter">
    <div class="relative bg-surface-container h-[300px] flex items-center p-12 overflow-hidden rounded-sm border border-outline-variant">
        <div class="relative z-10 w-3/5">
            <h3 class="font-headline-md text-headline-md text-on-surface mb-3">NEW ARRIVALS</h3>
            <p class="font-body-md text-body-md text-tertiary mb-6">Unleash your potential with the latest gear.</p>
            <a href="#" class="inline-block border-b-2 border-on-surface text-on-surface font-label-caps text-label-caps pb-1 hover:text-primary-container hover:border-primary-container transition-colors">SHOP NOW</a>
        </div>
    </div>
    <div class="relative bg-inverse-surface h-[300px] flex items-center p-12 overflow-hidden rounded-sm">
        <div class="relative z-10 w-3/5">
            <h3 class="font-headline-md text-headline-md text-on-primary mb-3">OUR BEST</h3>
            <p class="font-body-md text-body-md text-tertiary-fixed-dim mb-6">Stay ahead of the game.</p>
            <a href="#" class="inline-block border-b-2 border-primary-container text-primary-container font-label-caps text-label-caps pb-1 hover:text-on-primary hover:border-on-primary transition-colors">EXPLORE MORE</a>
        </div>
    </div>
</section>

<!-- Featured Products (empty state — wired in Phase 2) -->
<section class="w-full max-w-[1280px] mx-auto px-margin-mobile md:px-margin-desktop py-section-padding">
    <div class="flex flex-col md:flex-row justify-between items-center md:items-end mb-12 border-b border-outline-variant pb-4 gap-6">
        <h2 class="w-full text-center md:text-left font-display-lg-mobile md:font-display-lg text-display-lg-mobile md:text-display-lg text-on-surface">
            FEATURED GEAR
        </h2>
    </div>
    <div class="w-full text-center py-16 border border-dashed border-outline-variant rounded-sm">
        <span class="material-symbols-outlined text-tertiary text-[32px] mb-2 block">inventory_2</span>
        <p class="font-body-md text-body-md text-tertiary">Products will show here once the Product catalog is built (Phase 2).</p>
    </div>
</section>