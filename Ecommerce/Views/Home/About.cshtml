@model Ecommerce.Models.ViewModels.AboutVM
@{
    ViewData["Title"] = "About Us";
}

<!-- 1. HERO SECTION -->
<section class="js-hero-section relative w-full h-[65vh] min-h-[520px] flex items-center justify-center overflow-hidden bg-black mt-[-72px]">
    <!-- Background Image with Gradient Overlay -->
    <img src="https://images.unsplash.com/photo-1534438327276-14e5300c3a48?auto=format&fit=crop&w=1920&q=80" 
         alt="Athletes training hard" 
         class="absolute inset-0 w-full h-full object-cover opacity-45 scale-105 filter contrast-125" />
    <div class="absolute inset-0 bg-gradient-to-t from-black via-black/40 to-black/70"></div>
    
    <!-- Hero Content -->
    <div class="relative z-10 text-center px-4 mt-20 max-w-4xl mx-auto space-y-4">
        <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-primary/20 border border-primary/40 text-primary text-xs font-black uppercase tracking-[0.25em]">
            <span class="material-symbols-outlined text-[16px]">bolt</span>
            Our Philosophy &amp; Vision
        </span>
        
        <h1 class="text-white text-4xl sm:text-6xl md:text-7xl font-black uppercase tracking-tight leading-none">
            Built For The <br />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary via-red-400 to-amber-300">
                Uncompromising
            </span>
        </h1>
        
        <p class="text-white/85 text-base sm:text-lg md:text-xl font-normal max-w-2xl mx-auto leading-relaxed">
            We don't manufacture sportswear for passive lounging. Every stitch, seam, and fabric weave is engineered to endure your heaviest lifts and longest runs.
        </p>
    </div>
</section>

<!-- 2. STATS & COMMUNITY IMPACT COUNTER STRIP -->
<section class="w-full bg-surface-container-high border-y border-outline-variant/40 py-8 md:py-10">
    <div class="w-full px-4 md:px-8">
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8 text-center">
            <div class="space-y-1">
                <span class="text-2xl sm:text-4xl font-black text-primary tracking-tight">50,000+</span>
                <p class="text-xs uppercase tracking-widest font-bold text-on-surface">Athletes Geared Up</p>
            </div>
            <div class="space-y-1">
                <span class="text-2xl sm:text-4xl font-black text-on-surface tracking-tight">99.4%</span>
                <p class="text-xs uppercase tracking-widest font-bold text-tertiary">Verified Satisfaction</p>
            </div>
            <div class="space-y-1">
                <span class="text-2xl sm:text-4xl font-black text-primary tracking-tight">15+</span>
                <p class="text-xs uppercase tracking-widest font-bold text-on-surface">Custom Fabric Blends</p>
            </div>
            <div class="space-y-1">
                <span class="text-2xl sm:text-4xl font-black text-on-surface tracking-tight">100%</span>
                <p class="text-xs uppercase tracking-widest font-bold text-tertiary">Athlete Tested</p>
            </div>
        </div>
    </div>
</section>

<!-- 3. THE ORIGIN & MISSION (Split Layout) -->
<section class="w-full bg-surface py-16 md:py-24">
    <div class="w-full px-4 md:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
            
            <!-- Text Side -->
            <div class="space-y-6">
                <span class="text-primary font-bold tracking-[0.2em] uppercase text-xs block">The Standard</span>
                <h2 class="text-3xl md:text-5xl font-black text-on-surface uppercase tracking-tight leading-tight">
                    Tested On Heavy Sets.<br />
                    <span class="text-primary">Not In Studios.</span>
                </h2>
                <div class="w-16 h-1 bg-primary"></div>
                
                <p class="text-tertiary text-base md:text-lg leading-relaxed">
                    GymGear was founded on a simple observation: conventional sportswear was optimized for marketing campaigns and loungewear, not the reality of high-intensity training.
                </p>
                <p class="text-tertiary text-base md:text-lg leading-relaxed">
                    Barbell knurling shreds flimsy cotton. Low-grade elastane sags after two heavy sessions. We set out to change that by collaborating directly with powerlifters, runners, and hybrid athletes to engineer apparel with zero restrictions and indestructible construction.
                </p>

                <div class="pt-2 flex flex-col sm:flex-row gap-4">
                    <a asp-controller="Product" asp-action="Index" class="inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-primary text-on-primary font-bold text-xs uppercase tracking-widest rounded-sm hover:bg-primary/90 transition-all shadow-sm">
                        <span>Explore The Gear</span>
                        <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
                    </a>
                </div>
            </div>
            
            <!-- Image Side -->
            <div class="relative aspect-[4/3] md:aspect-square bg-surface-variant rounded-sm overflow-hidden border border-outline-variant/60 shadow-md group">
                <img src="https://images.unsplash.com/photo-1517836357463-d25dfeac3438?auto=format&fit=crop&w=1000&q=80" 
                     alt="Gym Equipment and Lifters" 
                     class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700 group-hover:scale-105" />
                <div class="absolute bottom-4 left-4 right-4 p-4 bg-black/80 backdrop-blur-md rounded-sm border border-white/10 text-white">
                    <p class="font-bold text-xs uppercase tracking-wider text-primary mb-0.5">Heavy Load Tested</p>
                    <p class="text-xs text-white/80">Every new silhouette undergoes 100+ hours of brutal gym stress testing.</p>
                </div>
            </div>
            
        </div>
    </div>
</section>

<!-- 4. CORE ENGINEERING PILLARS (4-Card Grid) -->
<section class="w-full bg-surface-container-lowest py-16 md:py-24 border-t border-outline-variant/30">
    <div class="w-full px-4 md:px-8">
        <div class="max-w-3xl mb-12">
            <span class="text-primary font-bold tracking-[0.2em] uppercase text-xs mb-2 block">Innovation &amp; Craft</span>
            <h2 class="text-3xl md:text-5xl font-black text-on-surface uppercase tracking-tight mb-4">
                Engineered Down To The Fiber
            </h2>
            <p class="text-tertiary text-base md:text-lg">
                We combine cutting-edge textile science with ergonomic athlete profiling to deliver uncompromising performance.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            <!-- Pillar 1 -->
            <div class="bg-surface p-6 sm:p-8 rounded-sm border border-outline-variant/60 hover:border-primary transition-all duration-300 space-y-4 group">
                <div class="w-12 h-12 rounded-sm bg-primary/10 border border-primary/20 text-primary flex items-center justify-center group-hover:bg-primary group-hover:text-on-primary transition-colors">
                    <span class="material-symbols-outlined text-[24px]">water_drop</span>
                </div>
                <h3 class="text-lg font-black uppercase text-on-surface tracking-tight">Capillary Moisture Management</h3>
                <p class="text-xs md:text-sm text-tertiary leading-relaxed">
                    Micro-grooved yarn structures actively channel sweat outward to the fabric exterior for instant evaporative cooling.
                </p>
            </div>

            <!-- Pillar 2 -->
            <div class="bg-surface p-6 sm:p-8 rounded-sm border border-outline-variant/60 hover:border-primary transition-all duration-300 space-y-4 group">
                <div class="w-12 h-12 rounded-sm bg-primary/10 border border-primary/20 text-primary flex items-center justify-center group-hover:bg-primary group-hover:text-on-primary transition-colors">
                    <span class="material-symbols-outlined text-[24px]">fitness_center</span>
                </div>
                <h3 class="text-lg font-black uppercase text-on-surface tracking-tight">Knurling-Resistant Fabric</h3>
                <p class="text-xs md:text-sm text-tertiary leading-relaxed">
                    High-density woven blends withstand direct barbell friction without pilling, fraying, or losing structural shape.
                </p>
            </div>

            <!-- Pillar 3 -->
            <div class="bg-surface p-6 sm:p-8 rounded-sm border border-outline-variant/60 hover:border-primary transition-all duration-300 space-y-4 group">
                <div class="w-12 h-12 rounded-sm bg-primary/10 border border-primary/20 text-primary flex items-center justify-center group-hover:bg-primary group-hover:text-on-primary transition-colors">
                    <span class="material-symbols-outlined text-[24px]">all_inclusive</span>
                </div>
                <h3 class="text-lg font-black uppercase text-on-surface tracking-tight">4-Way Kinetic Stretch</h3>
                <p class="text-xs md:text-sm text-tertiary leading-relaxed">
                    Biomechanical multidirectional elasticity allows full range of motion from deep squats to overhead presses with zero pinch points.
                </p>
            </div>

            <!-- Pillar 4 -->
            <div class="bg-surface p-6 sm:p-8 rounded-sm border border-outline-variant/60 hover:border-primary transition-all duration-300 space-y-4 group">
                <div class="w-12 h-12 rounded-sm bg-primary/10 border border-primary/20 text-primary flex items-center justify-center group-hover:bg-primary group-hover:text-on-primary transition-colors">
                    <span class="material-symbols-outlined text-[24px]">architecture</span>
                </div>
                <h3 class="text-lg font-black uppercase text-on-surface tracking-tight">Tapered Athlete Fit</h3>
                <p class="text-xs md:text-sm text-tertiary leading-relaxed">
                    Tailored specifically for athletic physiques with broader shoulders, narrow waists, and ergonomic raglan sleeves.
                </p>
            </div>
        </div>
    </div>
</section>

<!-- 5. 3-STAGE INNOVATION LIFECYCLE -->
<section class="w-full bg-surface py-16 md:py-24 border-t border-outline-variant/30">
    <div class="w-full px-4 md:px-8">
        <div class="text-center max-w-2xl mx-auto mb-14">
            <span class="text-primary font-bold tracking-[0.2em] uppercase text-xs mb-2 block">The Process</span>
            <h2 class="text-3xl md:text-5xl font-black text-on-surface uppercase tracking-tight">
                From Lab To Barbell
            </h2>
            <p class="text-tertiary text-sm md:text-base mt-2">
                How every piece of GymGear is conceived, prototyped, and certified.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div class="p-6 md:p-8 bg-surface-container-low/50 border border-outline-variant/60 rounded-sm relative">
                <span class="text-4xl font-black text-primary/30 mb-4 block">01</span>
                <h3 class="text-xl font-black text-on-surface uppercase tracking-tight mb-2">Biomechanical Mapping</h3>
                <p class="text-tertiary text-xs md:text-sm leading-relaxed">
                    We 3D scan lifters across complete movement arcs to position seams where they won't chafe or pull under maximum load.
                </p>
            </div>

            <div class="p-6 md:p-8 bg-surface-container-low/50 border border-outline-variant/60 rounded-sm relative">
                <span class="text-4xl font-black text-primary/30 mb-4 block">02</span>
                <h3 class="text-xl font-black text-on-surface uppercase tracking-tight mb-2">Gym Stress Testing</h3>
                <p class="text-tertiary text-xs md:text-sm leading-relaxed">
                    Prototypes are handed to competitive athletes who log hundreds of high-volume sets, sweat sessions, and commercial washes.
                </p>
            </div>

            <div class="p-6 md:p-8 bg-surface-container-low/50 border border-outline-variant/60 rounded-sm relative">
                <span class="text-4xl font-black text-primary/30 mb-4 block">03</span>
                <h3 class="text-xl font-black text-on-surface uppercase tracking-tight mb-2">The Drop</h3>
                <p class="text-tertiary text-xs md:text-sm leading-relaxed">
                    Only cuts that pass our strict durability and comfort thresholds make it to the production line and into your gym bag.
                </p>
            </div>
        </div>
    </div>
</section>

<!-- 3. TESTIMONIALS (Horizontal Carousel - 3 Cards Per Desktop View) -->
<section class="w-full bg-surface-container-lowest py-16 md:py-24 border-t border-outline-variant/30 overflow-x-hidden">
    <div class="w-full px-4 md:px-8">
        
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-10 gap-4">
            <div>
                <span class="text-primary font-bold tracking-[0.2em] uppercase text-xs mb-2 block">Athletes Voice</span>
                <h2 class="text-3xl md:text-5xl font-black text-on-surface uppercase tracking-tight">The Community</h2>
                <p class="text-tertiary text-base md:text-lg mt-1">Real feedback from athletes who put our gear to the test.</p>
            </div>

            @if (Model.Testimonials != null && Model.Testimonials.Any())
            {
                <!-- Navigation Controls (Desktop & Mobile Arrow Buttons) -->
                <div class="flex items-center gap-2 self-end md:self-auto">
                    <button type="button" 
                            id="prevTestimonialBtn" 
                            class="w-11 h-11 rounded-full border border-outline-variant bg-surface hover:bg-surface-variant hover:border-primary text-on-surface flex items-center justify-center transition-all focus:outline-none shadow-sm group"
                            aria-label="Previous Testimonials">
                        <span class="material-symbols-outlined text-[20px] text-current group-hover:text-primary transition-colors">arrow_back</span>
                    </button>
                    <button type="button" 
                            id="nextTestimonialBtn" 
                            class="w-11 h-11 rounded-full border border-outline-variant bg-surface hover:bg-surface-variant hover:border-primary text-on-surface flex items-center justify-center transition-all focus:outline-none shadow-sm group"
                            aria-label="Next Testimonials">
                        <span class="material-symbols-outlined text-[20px] text-current group-hover:text-primary transition-colors">arrow_forward</span>
                    </button>
                </div>
            }
        </div>

        @if (Model.Testimonials != null && Model.Testimonials.Any())
        {
            <!-- Smooth Horizontal Carousel Container -->
            <div id="testimonialsCarousel" 
                 class="flex overflow-x-auto snap-x snap-mandatory gap-4 md:gap-6 pb-6 hide-scrollbar scroll-smooth">
                @foreach (var t in Model.Testimonials)
                {
                    <div class="snap-start shrink-0 w-[85vw] sm:w-[55vw] md:w-[calc(33.333%-1rem)] bg-surface p-6 md:p-8 rounded-sm border border-outline-variant hover:border-primary/60 transition-all duration-300 flex flex-col justify-between shadow-sm group">
                        <div class="mb-6">
                            <!-- Star Rating Visual & Verified Badge -->
                            <div class="flex items-center justify-between gap-2 mb-4">
                                <div class="flex text-primary">
                                    @for (int i = 0; i < 5; i++)
                                    {
                                        <span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' 1;">star</span>
                                    }
                                </div>
                                <span class="inline-flex items-center gap-1 text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-primary/10 text-primary border border-primary/20">
                                    <span class="material-symbols-outlined text-[14px]">verified</span>
                                    Verified Athlete
                                </span>
                            </div>

                            <!-- Quote Body -->
                            <p class="text-on-surface text-base italic leading-relaxed font-normal">
                                &ldquo;@t.Text&rdquo;
                            </p>
                        </div>

                        <!-- Author & Date Metadata -->
                        <div class="border-t border-outline-variant/40 pt-4 flex items-center justify-between">
                            <div>
                                <p class="font-bold text-on-surface uppercase tracking-widest text-sm group-hover:text-primary transition-colors">
                                    @t.UserFullName
                                </p>
                                <p class="text-xs text-tertiary uppercase tracking-wider mt-0.5">
                                    @t.CreatedAt.ToString("MMM yyyy")
                                </p>
                            </div>
                            <span class="material-symbols-outlined text-outline-variant text-2xl group-hover:text-primary/40 transition-colors select-none">
                                format_quote
                            </span>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="w-full text-center py-20 border border-dashed border-outline-variant rounded-sm bg-surface">
                <span class="material-symbols-outlined text-tertiary text-[40px] mb-3 block">rate_review</span>
                <p class="text-lg text-tertiary font-medium">No approved testimonials yet.</p>
                <p class="text-sm text-tertiary mt-1">Be the first to leave your mark below.</p>
            </div>
        }
    </div>
</section>

<!-- 4. SUBMIT EXPERIENCE (Form) -->
<section class="w-full bg-surface py-16 md:py-24 border-t border-outline-variant/30">
    <div class="max-w-[680px] mx-auto px-4 text-center">
        
        <h2 class="text-2xl md:text-4xl font-black text-on-surface uppercase tracking-tight mb-3">Leave Your Mark</h2>
        <p class="text-tertiary mb-10">Your testimonial will be reviewed before it hits the live wall.</p>

        @if (User.Identity == null || !User.Identity.IsAuthenticated)
        {
            <div class="bg-surface-container-low border-l-4 border-primary p-6 text-left shadow-sm">
                <p class="text-on-surface font-medium">
                    You must be a part of the crew to drop a review. 
                    <a asp-controller="Account" asp-action="Login" class="text-primary hover:underline font-bold uppercase tracking-widest text-sm ml-2">Sign In</a>
                </p>
            </div>
        }
        else
        {
            <form asp-controller="Home" asp-action="SubmitTestimonial" method="post" class="text-left bg-surface-container-low p-8 rounded-sm border border-outline-variant shadow-sm">
                
                <div class="mb-6">
                    <label asp-for="NewTestimonial.Text" class="text-xs font-bold uppercase tracking-widest text-on-surface mb-2 block">Your Experience</label>
                    <textarea asp-for="NewTestimonial.Text" 
                              class="w-full bg-surface text-on-surface border border-outline-variant p-4 rounded-sm focus:ring-1 focus:ring-primary focus:border-primary transition-all resize-none" 
                              rows="5" 
                              placeholder="How did the gear hold up during your hardest session?"></textarea>
                    <span asp-validation-for="NewTestimonial.Text" class="text-primary text-xs font-bold uppercase tracking-widest block mt-2"></span>
                </div>

                <button type="submit" class="w-full bg-primary text-on-primary font-bold uppercase tracking-widest py-4 rounded-sm hover:bg-primary/90 transition-colors flex items-center justify-center gap-2 group">
                    Submit For Review
                    <span class="material-symbols-outlined text-[20px] transform group-hover:translate-x-1 transition-transform">send</span>
                </button>
            </form>
        }
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const carousel = document.getElementById("testimonialsCarousel");
            const prevBtn = document.getElementById("prevTestimonialBtn");
            const nextBtn = document.getElementById("nextTestimonialBtn");

            if (carousel && prevBtn && nextBtn) {
                prevBtn.addEventListener("click", function () {
                    const firstCard = carousel.querySelector(".snap-start");
                    const scrollDistance = firstCard ? firstCard.offsetWidth + 24 : 350;
                    carousel.scrollBy({ left: -scrollDistance, behavior: "smooth" });
                });

                nextBtn.addEventListener("click", function () {
                    const firstCard = carousel.querySelector(".snap-start");
                    const scrollDistance = firstCard ? firstCard.offsetWidth + 24 : 350;
                    carousel.scrollBy({ left: scrollDistance, behavior: "smooth" });
                });
            }
        });
    </script>
}
