@model Ecommerce.Models.ViewModels.CartVM

@{
    ViewData["Title"] = "Your Cart";
}

<div class="w-full max-w-[1280px] mx-auto px-margin-mobile md:px-margin-desktop py-section-padding">
    <div class="flex items-center justify-between mb-4">
        <h1 class="font-headline-md text-headline-md text-on-surface">
            Your Cart
        </h1>

        <span class="font-body-md text-body-md text-tertiary">
            @Model.Items.Count Item@(Model.Items.Count == 1 ? "" : "s")
        </span>
    </div>

    @if (Model.Items != null && Model.Items.Any())
    {
        <div class="flex flex-col lg:flex-row gap-gutter">

            <!-- Cart Items -->
            <div class="flex-1 flex flex-col gap-4">

                <div class="bg-surface-variant border border-outline-variant p-4 rounded flex items-center gap-3">
                    <span class="material-symbols-outlined text-primary">
                        info
                    </span>

                    <p class="font-body-md text-body-md text-on-surface-variant">
                        Add items without an account — sign in only required at checkout.
                    </p>
                </div>

                @foreach (var item in Model.Items)
                {
                    <div class="bg-surface-container-lowest border border-surface-container flex flex-col sm:flex-row p-6 gap-6 rounded">

                        <!-- Product Image -->
                        <div class="w-full sm:w-32 h-32 bg-surface-container shrink-0 rounded overflow-hidden">
                            @if (!string.IsNullOrEmpty(item.MainImagePath))
                            {
                                <img class="w-full h-full object-cover"
                                     src="@item.MainImagePath"
                                     alt="@item.ProductName" />
                            }
                            else
                            {
                                <div class="w-full h-full flex items-center justify-center text-tertiary font-label-caps text-label-caps">
                                    NO IMAGE
                                </div>
                            }
                        </div>

                        <!-- Product Information -->
                        <div class="flex flex-col justify-between flex-grow gap-4 sm:gap-0">

                            <div class="flex justify-between items-start">
                                <div>
                                    <span class="font-label-caps text-label-caps text-secondary block mb-1">
                                        @item.CategoryName?.ToUpper()
                                    </span>

                                    <h2 class="font-headline-sm text-headline-sm text-on-surface">
                                        @item.ProductName
                                    </h2>
                                </div>

                                <!-- Remove Button -->
                                <form asp-controller="Cart"
                                      asp-action="Remove"
                                      method="post">

                                    <input type="hidden"
                                           name="cartItemId"
                                           value="@item.CartItemId" />

                                    <button type="submit"
                                            class="text-secondary hover:text-primary transition-colors"
                                            title="Remove item">

                                        <span class="material-symbols-outlined">
                                            close
                                        </span>
                                    </button>
                                </form>
                            </div>

                            <div class="flex justify-between items-end">

                                <!-- Quantity Controls -->
                                <form asp-controller="Cart"
                                      asp-action="UpdateQuantity"
                                      method="post"
                                      class="flex items-center border border-outline-variant rounded">

                                    <input type="hidden"
                                           name="cartItemId"
                                           value="@item.CartItemId" />

                                    <!-- Decrease Quantity -->
                                    <button type="submit"
                                            name="quantity"
                                            value="@(item.Quantity - 1)"
                                            title="@(item.Quantity == 1 ? "Remove item" : "Decrease quantity")"
                                            class="px-3 py-1 text-on-surface hover:bg-surface-container transition-colors">
                                        -
                                    </button>

                                    <span class="font-body-md text-body-md px-3 py-1 border-x border-outline-variant">
                                        @item.Quantity
                                    </span>

                                    <!-- Increase Quantity -->
                                    <button type="submit"
                                            name="quantity"
                                            value="@(item.Quantity + 1)"
                                            title="Increase quantity"
                                            class="px-3 py-1 text-on-surface hover:bg-surface-container transition-colors">
                                        +
                                    </button>
                                </form>

                                <span class="font-price-display text-price-display text-on-surface">
                                    @item.LineTotal.ToString("C")
                                </span>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Order Summary -->
            <div class="w-full lg:w-1/3">
                <div class="bg-surface-container-lowest border border-surface-container p-6 rounded sticky top-[100px] flex flex-col gap-6">

                    <h3 class="font-headline-sm text-headline-sm border-b border-surface-container pb-4">
                        Order Summary
                    </h3>

                    <div class="flex flex-col gap-3 font-body-md text-body-md">

                        <div class="flex justify-between text-secondary">
                            <span>Subtotal</span>

                            <span class="text-on-surface">
                                @Model.Subtotal.ToString("C")
                            </span>
                        </div>

                        <div class="flex justify-between text-secondary">
                            <span>Estimated Shipping</span>
                            <span class="text-on-surface">Free</span>
                        </div>

                        <div class="flex justify-between text-secondary">
                            <span>Tax</span>
                            <span class="text-on-surface">
                                Calculated at checkout
                            </span>
                        </div>
                    </div>

                    <div class="border-t border-surface-container pt-4 flex justify-between items-center">
                        <span class="font-headline-sm text-headline-sm">
                            Total
                        </span>

                        <span class="font-price-display text-price-display text-primary-container">
                            @Model.Subtotal.ToString("C")
                        </span>
                    </div>

                    <a asp-controller="Checkout"
                       asp-action="Index"
                       class="w-full bg-primary-container text-on-primary font-label-caps text-label-caps py-4 rounded hover:bg-primary transition-colors flex items-center justify-center gap-2 mt-4">

                        PROCEED TO CHECKOUT

                        <span class="material-symbols-outlined">
                            arrow_forward
                        </span>
                    </a>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="w-full text-center py-24 border border-dashed border-outline-variant rounded-sm">

            <span class="material-symbols-outlined text-tertiary text-[32px] mb-2 block">
                shopping_cart
            </span>

            <p class="font-body-md text-body-md text-tertiary mb-4">
                Your cart is empty.
            </p>

            <a asp-controller="Product"
               asp-action="Index"
               class="inline-block bg-primary-container text-on-primary font-label-caps text-label-caps px-8 py-3 rounded hover:bg-surface-tint transition-all">

                CONTINUE SHOPPING
            </a>
        </div>
    }
</div>