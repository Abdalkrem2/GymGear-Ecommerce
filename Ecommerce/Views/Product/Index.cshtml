@model Ecommerce.Models.ViewModels.ProductListVM

@{
    var selectedCollection =
        ViewBag.SelectedCollection as string;

    var isMensCollection =
        string.Equals(
            selectedCollection,
            "mens",
            StringComparison.OrdinalIgnoreCase
        );

    var isWomensCollection =
        string.Equals(
            selectedCollection,
            "womens",
            StringComparison.OrdinalIgnoreCase
        );

    ViewData["Title"] = isMensCollection
        ? "Shop Men"
        : isWomensCollection
            ? "Shop Women"
            : "Shop";
}

<div class="w-full max-w-[1280px] mx-auto px-margin-mobile md:px-margin-desktop py-section-padding flex flex-col md:flex-row gap-gutter">

    <!-- Sidebar Filters -->
    <aside class="w-full md:w-64 shrink-0 flex flex-col gap-8">

        <form asp-controller="Product"
              asp-action="Index"
              method="get"
              class="flex flex-col gap-8">

            <!-- Preserve Men/Women Collection -->
            @if (!string.IsNullOrWhiteSpace(selectedCollection))
            {
                <input type="hidden"
                       name="category"
                       value="@selectedCollection" />
            }

            <div class="flex justify-between items-center">

                <h2 class="font-headline-sm text-headline-sm text-on-surface">
                    Filters
                </h2>

                <a asp-controller="Product"
                   asp-action="Index"
                   asp-route-category="@selectedCollection"
                   class="font-label-caps text-label-caps text-tertiary hover:text-primary-container">
                    Clear
                </a>
            </div>

            <!-- Categories -->
            <div>
                <h3 class="font-label-caps text-label-caps text-on-surface mb-2">
                    Categories
                </h3>

                <div class="flex flex-col gap-2">

                    <label class="flex items-center gap-2 font-body-md text-body-md text-tertiary">

                        <input type="radio"
                               name="categoryId"
                               value=""
                               class="text-primary-container"
                               onchange="this.form.submit()"
                               checked="@(Model.SelectedCategoryId == null ? "checked" : null)" />

                        @if (isMensCollection)
                        {
                            <span>All Men's Products</span>
                        }
                        else if (isWomensCollection)
                        {
                            <span>All Women's Products</span>
                        }
                        else
                        {
                            <span>All Products</span>
                        }
                    </label>

                    @foreach (var category in Model.Categories)
                    {
                        <label class="flex items-center gap-2 font-body-md text-body-md text-tertiary">

                            <input type="radio"
                                   name="categoryId"
                                   value="@category.Id"
                                   class="text-primary-container"
                                   onchange="this.form.submit()"
                                   checked="@(Model.SelectedCategoryId == category.Id ? "checked" : null)" />

                            <span>@category.Name</span>
                        </label>
                    }
                </div>
            </div>

            <!-- Price Range -->
            <div>
                <h3 class="font-label-caps text-label-caps text-on-surface mb-3">
                    Price Range
                </h3>

                <div class="grid grid-cols-2 gap-2">

                    <input type="number"
                           name="minPrice"
                           min="0"
                           step="0.01"
                           placeholder="Min $"
                           value="@Model.MinPrice"
                           class="input-field text-sm" />

                    <input type="number"
                           name="maxPrice"
                           min="0"
                           step="0.01"
                           placeholder="Max $"
                           value="@Model.MaxPrice"
                           class="input-field text-sm" />
                </div>

                <button type="submit"
                        class="w-full mt-3 bg-on-surface text-on-primary py-2 font-bold uppercase tracking-widest rounded-sm hover:opacity-90 transition-opacity">
                    Apply Price
                </button>
            </div>

            <!-- Sort -->
            <div>
                <h3 class="font-label-caps text-label-caps text-on-surface mb-3">
                    Sort By
                </h3>

                <select name="sort"
                        class="input-field text-sm"
                        onchange="this.form.submit()">

                    <option value=""
                            selected="@(string.IsNullOrEmpty(Model.SortBy) ? "selected" : null)">
                        Recommended
                    </option>

                    <option value="price_asc"
                            selected="@(Model.SortBy == "price_asc" ? "selected" : null)">
                        Price: Low to High
                    </option>

                    <option value="price_desc"
                            selected="@(Model.SortBy == "price_desc" ? "selected" : null)">
                        Price: High to Low
                    </option>

                    <option value="newest"
                            selected="@(Model.SortBy == "newest" ? "selected" : null)">
                        Newest
                    </option>
                </select>
            </div>

        </form>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 flex flex-col">

        <!-- Breadcrumb -->
        <nav aria-label="Breadcrumb"
             class="flex items-center gap-2 text-sm text-tertiary mb-2">

            <a asp-controller="Home"
               asp-action="Index"
               class="hover:text-on-surface">
                Home
            </a>

            <span>/</span>

            @if (isMensCollection)
            {
                <span class="text-on-surface">
                    Shop Men
                </span>
            }
            else if (isWomensCollection)
            {
                <span class="text-on-surface">
                    Shop Women
                </span>
            }
            else
            {
                <span class="text-on-surface">
                    Shop
                </span>
            }
        </nav>

        <!-- Heading -->
        <h1 class="font-headline-md text-headline-md text-on-surface mb-6">

            @if (Model.SelectedCategoryId != null)
            {
                var selectedCategory =
                    Model.Categories.FirstOrDefault(category =>
                        category.Id == Model.SelectedCategoryId);

                @(selectedCategory?.Name ?? "Products")
            }
            else if (isMensCollection)
            {
                @:Men's Collection
            }
            else if (isWomensCollection)
            {
                @:Women's Collection
            }
            else
            {
                @:All Products
            }
        </h1>

        @if (Model.Products != null && Model.Products.Any())
        {
            <!-- Product Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-gutter mb-12">

                @foreach (var product in Model.Products)
                {
                    <a asp-controller="Product"
                       asp-action="Details"
                       asp-route-id="@product.Id"
                       class="group bg-surface-container-lowest border border-surface-container hover:border-surface-variant hover:shadow-sm transition-all duration-300 relative flex flex-col">

                        <!-- Product Image -->
                        <div class="product-card-image relative w-full aspect-[4/5] bg-white overflow-hidden flex items-center justify-center">

                            @if (!string.IsNullOrWhiteSpace(product.MainImagePath))
                            {
                                <img src="@product.MainImagePath"
                                     alt="@product.Name"
                                     class="w-full h-full object-contain p-3"
                                     loading="lazy" />
                            }
                            else
                            {
                                <div class="w-full h-full flex items-center justify-center text-tertiary font-label-caps text-label-caps">
                                    NO IMAGE
                                </div>
                            }
                        </div>

                        <!-- Product Information -->
                        <div class="p-6 flex flex-col flex-grow">

                            <span class="font-label-caps text-label-caps text-tertiary mb-1">
                                @product.CategoryName?.ToUpper()
                            </span>

                            <h3 class="font-headline-sm text-headline-sm text-on-surface mb-2">
                                @product.Name
                            </h3>

                            <div class="mt-auto flex items-center justify-between">

                                <span class="font-price-display text-price-display text-on-surface">
                                    @product.Price.ToString("C")
                                </span>
                            </div>
                        </div>
                    </a>
                }
            </div>

            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <div class="flex justify-center items-center gap-2 mt-auto border-t border-surface-container pt-8">

                    @for (int pageNumber = 1;
                         pageNumber <= Model.TotalPages;
                         pageNumber++)
                    {
                        <a asp-controller="Product"
                           asp-action="Index"
                           asp-route-category="@selectedCollection"
                           asp-route-page="@pageNumber"
                           asp-route-categoryId="@Model.SelectedCategoryId"
                           asp-route-minPrice="@Model.MinPrice"
                           asp-route-maxPrice="@Model.MaxPrice"
                           asp-route-sort="@Model.SortBy"
                           class="w-10 h-10 flex items-center justify-center font-bold border @(pageNumber == Model.CurrentPage
                                                          ? "bg-on-surface text-on-primary border-on-surface"
                                                          : "border-surface-container text-tertiary hover:border-on-surface hover:text-on-surface transition-colors")">

                    @pageNumber
                </a>
            }
        </div>
    }
}
        else
{
    <!-- No Products -->
    <div class="w-full text-center py-24 border border-dashed border-outline-variant rounded-sm">

        <span class="material-symbols-outlined text-tertiary text-[32px] mb-2 block">
            inventory_2
        </span>

        <p class="font-body-md text-body-md text-tertiary">
            No products match your filters.
        </p>
    </div>
}

</main>
</div>