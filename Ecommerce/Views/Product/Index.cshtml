@using System.Globalization
@model Ecommerce.Models.ViewModels.ProductListVM

@{
    var selectedCollection = ViewBag.SelectedCollection as string;

    var isMensCollection = string.Equals(
        selectedCollection,
        "mens",
        StringComparison.OrdinalIgnoreCase
    );

    var isWomensCollection = string.Equals(
        selectedCollection,
        "womens",
        StringComparison.OrdinalIgnoreCase
    );

    ViewData["Title"] = isMensCollection
        ? "Shop Men"
        : isWomensCollection
            ? "Shop Women"
            : "Shop";
}

<div class="w-full px-4 md:px-8 pt-20 pb-24 flex flex-col lg:flex-row gap-6 lg:gap-8 items-start">

    <!-- Sidebar Filters -->
    <aside class="w-full lg:w-64 shrink-0 bg-surface-container-low/50 border border-outline-variant/40 rounded-sm p-5 flex flex-col gap-6 lg:sticky lg:top-24">

        <form asp-controller="Product"
              asp-action="Index"
              method="get"
              class="flex flex-col gap-6">

            @if (!string.IsNullOrWhiteSpace(selectedCollection))
            {
                <input type="hidden"
                       name="category"
                       value="@selectedCollection" />
            }

            <div class="flex justify-between items-center pb-3 border-b border-outline-variant/30">
                <h2 class="font-black text-sm uppercase tracking-widest text-on-surface">
                    Filters
                </h2>

                <a asp-controller="Product"
                   asp-action="Index"
                   asp-route-category="@selectedCollection"
                   class="text-xs font-bold uppercase tracking-wider text-tertiary hover:text-primary transition-colors">
                    Clear All
                </a>
            </div>

            <!-- Categories -->
            <div>
                <h3 class="text-xs font-bold uppercase tracking-wider text-on-surface mb-3">
                    Categories
                </h3>

                <div class="flex flex-col gap-2.5">
                    <label class="flex items-center gap-2.5 text-xs text-tertiary hover:text-on-surface cursor-pointer">
                        <input type="radio"
                               name="categoryId"
                               value=""
                               class="text-primary focus:ring-primary accent-primary"
                               onchange="this.form.submit()"
                        @(Model.SelectedCategoryId == null
                            ? "checked"
                            : "") />

                        @if (isMensCollection)
                        {
                            <span class="font-medium">All Men's Products</span>
                        }
                        else if (isWomensCollection)
                        {
                            <span class="font-medium">All Women's Products</span>
                        }
                        else
                        {
                            <span class="font-medium">All Products</span>
                        }
                    </label>

                    @foreach (var cat in Model.Categories)
                    {
                        <label class="flex items-center gap-2.5 text-xs text-tertiary hover:text-on-surface cursor-pointer">
                            <input type="radio"
                                   name="categoryId"
                                   value="@cat.Id"
                                   class="text-primary focus:ring-primary accent-primary"
                                   onchange="this.form.submit()"
                            @(Model.SelectedCategoryId == cat.Id
                                ? "checked"
                                : "") />

                            <span class="font-medium">@cat.Name</span>
                        </label>
                    }
                </div>
            </div>

            <!-- Price Range -->
            <div class="pt-3 border-t border-outline-variant/30">
                <h3 class="text-xs font-bold uppercase tracking-wider text-on-surface mb-3">
                    Price Range
                </h3>

                <div class="grid grid-cols-2 gap-2">
                    <input type="number"
                           name="minPrice"
                           min="0"
                           step="0.01"
                           placeholder="Min $"
                           value="@Model.MinPrice"
                           onchange="this.form.submit()"
                           class="w-full bg-surface border border-outline-variant text-on-surface px-3 py-2 text-xs rounded-sm focus:border-primary outline-none" />

                    <input type="number"
                           name="maxPrice"
                           min="0"
                           step="0.01"
                           placeholder="Max $"
                           value="@Model.MaxPrice"
                           onchange="this.form.submit()"
                           class="w-full bg-surface border border-outline-variant text-on-surface px-3 py-2 text-xs rounded-sm focus:border-primary outline-none" />
                </div>
            </div>

            <!-- Sort -->
            <div class="pt-3 border-t border-outline-variant/30">
                <h3 class="text-xs font-bold uppercase tracking-wider text-on-surface mb-3">
                    Sort By
                </h3>

                <select name="sort"
                        class="w-full bg-surface border border-outline-variant text-on-surface px-3 py-2 text-xs rounded-sm focus:border-primary outline-none cursor-pointer"
                        onchange="this.form.submit()">

                    <option value=""
                            selected="@(string.IsNullOrEmpty(Model.SortBy)
                                        ? "selected"
                                        : null)">
                        Recommended
                    </option>

                    <option value="price_asc"
                            selected="@(Model.SortBy == "price_asc"
                                        ? "selected"
                                        : null)">
                        Price: Low to High
                    </option>

                    <option value="price_desc"
                            selected="@(Model.SortBy == "price_desc"
                                        ? "selected"
                                        : null)">
                        Price: High to Low
                    </option>

                    <option value="newest"
                            selected="@(Model.SortBy == "newest"
                                        ? "selected"
                                        : null)">
                        Newest
                    </option>
                </select>
            </div>

        </form>
    </aside>

    <!-- Product Grid Area (Full horizontal expansion) -->
    <main class="flex-1 min-w-0 flex flex-col">

        <!-- Breadcrumb & Header -->
        <div class="mb-6 flex flex-col md:flex-row md:items-end justify-between gap-4">
            <div>
                <nav aria-label="Breadcrumb"
                     class="flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-tertiary mb-2">
                    <a asp-controller="Home"
                       asp-action="Index"
                       class="hover:text-primary transition-colors">
                        Home
                    </a>
                    <span>/</span>
                    @if (isMensCollection)
                    {
                        <span class="text-on-surface">Shop Men</span>
                    }
                    else if (isWomensCollection)
                    {
                        <span class="text-on-surface">Shop Women</span>
                    }
                    else
                    {
                        <span class="text-on-surface">Shop All</span>
                    }
                </nav>

                <h1 class="text-2xl md:text-4xl font-black text-on-surface uppercase tracking-tight">
                    @if (Model.SelectedCategoryId != null)
                    {
                        var selectedCategory = Model.Categories.FirstOrDefault(category => category.Id == Model.SelectedCategoryId);
                        @(selectedCategory?.Name ?? "Products")
                    }
                    else if (isMensCollection)
                    {
                        @:Men's Collection
                    }
                    else if (isWomensCollection)
                    {
                        @:Women's Collection
                    }
                    else
                    {
                        @:All Products
                    }
                </h1>
            </div>

            <p class="text-xs font-semibold text-tertiary uppercase tracking-wider">
                Showing @(Model.Products?.Count ?? 0) Product@(Model.Products?.Count == 1 ? "" : "s")
            </p>
        </div>

        @if (Model.Products != null && Model.Products.Any())
        {
            <!-- Full-Bleed Expansive Product Grid -->
            <div class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-4 2xl:grid-cols-4 gap-3.5 sm:gap-4 md:gap-6 mb-12">

                @foreach (var product in Model.Products)
                {
                    <a asp-controller="Product"
                       asp-action="Details"
                       asp-route-id="@product.Id"
                       class="group flex flex-col bg-surface rounded-sm cursor-pointer block">

                        <!-- Aspect-Ratio Correct Image Container -->
                        <div class="relative w-full aspect-[3/4] bg-surface-container-low border border-outline-variant/60 rounded-sm overflow-hidden mb-3 flex items-center justify-center p-4">
                            @if (!string.IsNullOrEmpty(product.MainImagePath))
                            {
                                <img class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-500"
                                     src="@product.MainImagePath"
                                     alt="@product.Name"
                                     loading="lazy" />
                            }
                            else
                            {
                                <div class="w-full h-full flex items-center justify-center text-tertiary font-label-caps text-xs">
                                    NO IMAGE
                                </div>
                            }
                        </div>

                        <!-- Product Information -->
                        <div class="flex flex-col flex-grow">
                            <span class="text-[11px] font-semibold tracking-wider text-tertiary uppercase mb-1 truncate">
                                @product.CategoryName
                            </span>

                            <h3 class="font-bold text-sm md:text-base text-on-surface group-hover:text-primary transition-colors leading-snug mb-1.5 truncate">
                                @product.Name
                            </h3>

                            <span class="font-body-md text-sm md:text-base font-semibold text-on-surface tracking-tight">
                                @product.Price.ToString("C", new CultureInfo("en-US"))
                            </span>
                        </div>
                    </a>
                }
            </div>
        }
        else
        {
            <!-- No Products -->
            <div class="w-full text-center py-24 border border-dashed border-outline-variant/60 rounded-sm bg-surface-container-low/30">
                <span class="material-symbols-outlined text-tertiary text-[36px] mb-2 block">
                    inventory_2
                </span>
                <p class="text-on-surface font-bold text-base mb-1">
                    No products found
                </p>
                <p class="text-tertiary text-xs">
                    Try adjusting your filters or search keywords.
                </p>
            </div>
        }
    </main>
</div>

<!-- Exact Screen-Centered Full-Width Pagination -->
@if (Model.TotalPages > 1)
{
    <div class="w-full px-4 md:px-8 pb-24">
        <div class="w-full border-t border-outline-variant/30 pt-8 flex justify-center items-center gap-2">
            @if (Model.CurrentPage > 1)
            {
                <a asp-controller="Product"
                   asp-action="Index"
                   asp-route-category="@selectedCollection"
                   asp-route-page="@(Model.CurrentPage - 1)"
                   asp-route-categoryId="@Model.SelectedCategoryId"
                   asp-route-minPrice="@Model.MinPrice"
                   asp-route-maxPrice="@Model.MaxPrice"
                   asp-route-sort="@Model.SortBy"
                   class="w-10 h-10 flex items-center justify-center font-bold border border-outline-variant rounded-sm text-sm bg-surface text-on-surface hover:border-primary hover:text-primary transition-colors shadow-sm"
                   aria-label="Previous page">
                    <span class="material-symbols-outlined text-[18px]">chevron_left</span>
                </a>
            }

            @for (int pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
            {
                <a asp-controller="Product"
                   asp-action="Index"
                   asp-route-category="@selectedCollection"
                   asp-route-page="@pageNumber"
                   asp-route-categoryId="@Model.SelectedCategoryId"
                   asp-route-minPrice="@Model.MinPrice"
                   asp-route-maxPrice="@Model.MaxPrice"
                   asp-route-sort="@Model.SortBy"
                   class="w-10 h-10 flex items-center justify-center font-bold border rounded-sm text-sm shadow-sm transition-all @(pageNumber == Model.CurrentPage
                                                                 ? "bg-primary text-on-primary border-primary ring-2 ring-primary/20"
                                                                 : "border-outline-variant bg-surface text-tertiary hover:border-primary hover:text-primary")">
                    @pageNumber
                </a>
            }

            @if (Model.CurrentPage < Model.TotalPages)
            {
                <a asp-controller="Product"
                   asp-action="Index"
                   asp-route-category="@selectedCollection"
                   asp-route-page="@(Model.CurrentPage + 1)"
                   asp-route-categoryId="@Model.SelectedCategoryId"
                   asp-route-minPrice="@Model.MinPrice"
                   asp-route-maxPrice="@Model.MaxPrice"
                   asp-route-sort="@Model.SortBy"
                   class="w-10 h-10 flex items-center justify-center font-bold border border-outline-variant rounded-sm text-sm bg-surface text-on-surface hover:border-primary hover:text-primary transition-colors shadow-sm"
                   aria-label="Next page">
                    <span class="material-symbols-outlined text-[18px]">chevron_right</span>
                </a>
            }
        </div>
    </div>
}
