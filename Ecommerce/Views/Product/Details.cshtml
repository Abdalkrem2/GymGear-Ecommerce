@model Ecommerce.Models.Entities.Product
@{
    ViewData["Title"] = Model.Name;
}

<div class="w-full bg-background pt-24 pb-16">
    <div class="max-w-[1280px] mx-auto px-4 md:px-margin-desktop">

        <!-- Breadcrumbs -->
        <nav class="flex text-xs font-bold uppercase tracking-widest text-tertiary mb-6">
            <a asp-controller="Home" asp-action="Index" class="hover:text-primary transition-colors">Home</a>
            <span class="mx-2">/</span>
            <a asp-controller="Product" asp-action="Index" class="hover:text-primary transition-colors">Shop</a>
            <span class="mx-2">/</span>
            <span class="text-on-surface">@Model.Name</span>
        </nav>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16">

            <!-- LEFT COLUMN: Image Gallery -->
            <div class="lg:col-span-7 flex flex-col gap-4">
                <!-- Main Image (If you have multiple images in the future, you can loop them here in a 2-column grid) -->
                <div class="w-full bg-surface-variant aspect-[4/5] rounded-sm overflow-hidden flex items-center justify-center relative">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" alt="@Model.Name" class="w-full h-full object-cover" />
                    }
                    else
                    {
                        <span class="font-headline-md text-tertiary uppercase tracking-widest">Product Image</span>
                    }
                </div>
            </div>

            <!-- RIGHT COLUMN: Product Details (Sticky) -->
            <div class="lg:col-span-5 relative">
                <div class="sticky top-28 flex flex-col">

                    <!-- Title & Price -->
                    <div class="border-b border-outline-variant/30 pb-6 mb-6">
                        <h1 class="text-3xl md:text-5xl font-black text-on-surface uppercase tracking-tight mb-2">
                            @Model.Name
                        </h1>
                        <p class="text-xl md:text-2xl font-medium text-on-surface">
                            $@Model.Price.ToString("0.00")
                        </p>
                    </div>

                    <!-- Add to Cart Form -->
                    <form asp-controller="Cart" asp-action="Add" method="post" class="flex flex-col gap-6 mb-8">
                        <input type="hidden" name="productId" value="@Model.Id" />

                        <!-- Quantity Selector -->
                        <div class="flex flex-col gap-2">
                            <label for="quantity" class="text-xs font-bold uppercase tracking-widest text-on-surface">Quantity</label>
                            <div class="flex items-center border border-outline-variant rounded-sm w-32">
                                <button type="button" onclick="decrementQty()" class="px-4 py-2 text-tertiary hover:text-on-surface transition-colors focus:outline-none">-</button>
                                <input type="number" id="quantity" name="quantity" value="1" min="1" class="w-full text-center bg-transparent border-none focus:ring-0 text-on-surface font-medium p-0" />
                                <button type="button" onclick="incrementQty()" class="px-4 py-2 text-tertiary hover:text-on-surface transition-colors focus:outline-none">+</button>
                            </div>
                        </div>

                        <!-- CTA Buttons -->
                        <div class="flex flex-col gap-3 mt-4">
                            <button type="submit" class="w-full bg-primary text-on-primary py-4 font-bold uppercase tracking-widest rounded-sm hover:bg-primary/90 transition-colors flex items-center justify-center gap-2">
                                Add To Cart <span class="material-symbols-outlined text-[20px]">shopping_bag</span>
                            </button>
                            <a asp-controller="Wishlist" asp-action="Add" asp-route-id="@Model.Id" class="w-full bg-surface border border-outline-variant text-on-surface py-4 font-bold uppercase tracking-widest rounded-sm hover:bg-surface-variant transition-colors flex items-center justify-center gap-2">
                                Save to Wishlist <span class="material-symbols-outlined text-[20px]">favorite_border</span>
                            </a>
                        </div>
                    </form>

                    <!-- Accordion: Description & Reviews -->
                    <div class="border-t border-outline-variant/30 flex flex-col">

                        <!-- Description Accordion -->
                        <div class="border-b border-outline-variant/30">
                            <button type="button" class="accordion-toggle w-full flex items-center justify-between py-5 focus:outline-none group">
                                <span class="text-sm font-bold uppercase tracking-widest text-on-surface group-hover:text-primary transition-colors">Description</span>
                                <span class="material-symbols-outlined text-tertiary group-hover:text-primary transition-colors accordion-icon">remove</span>
                            </button>
                            <!-- Content (Visible by default) -->
                            <div class="accordion-content pb-5 text-tertiary-fixed-dim text-sm leading-relaxed block">
                                @if (!string.IsNullOrEmpty(Model.Description))
                                {
                                    @Html.Raw(Model.Description)
                                }
                                else
                                {
                                    <p>Engineered for maximum performance and durability. This gear is built to withstand your toughest workouts.</p>
                                }
                            </div>
                        </div>

                        <!-- Reviews Accordion -->
                        <div class="border-b border-outline-variant/30">
                            <button type="button" class="accordion-toggle w-full flex items-center justify-between py-5 focus:outline-none group">
                                <span class="text-sm font-bold uppercase tracking-widest text-on-surface group-hover:text-primary transition-colors">Reviews</span>
                                <span class="material-symbols-outlined text-tertiary group-hover:text-primary transition-colors accordion-icon">add</span>
                            </button>
                            <!-- Content (Hidden by default) -->
                            <div class="accordion-content pb-5 text-tertiary-fixed-dim text-sm leading-relaxed hidden">
                                <p class="mb-4">No reviews yet. Be the first to review this gear.</p>
                                <!-- Future Review Form could go here -->
                                <a asp-controller="Comment" asp-action="Create" asp-route-productId="@Model.Id" class="text-primary underline font-medium">Write a Review</a>
                            </div>
                        </div>

                        <!-- Delivery Accordion -->
                        <div class="border-b border-outline-variant/30">
                            <button type="button" class="accordion-toggle w-full flex items-center justify-between py-5 focus:outline-none group">
                                <span class="text-sm font-bold uppercase tracking-widest text-on-surface group-hover:text-primary transition-colors">Delivery & Returns</span>
                                <span class="material-symbols-outlined text-tertiary group-hover:text-primary transition-colors accordion-icon">add</span>
                            </button>
                            <!-- Content (Hidden by default) -->
                            <div class="accordion-content pb-5 text-tertiary-fixed-dim text-sm leading-relaxed hidden">
                                <ul class="list-disc pl-4 space-y-2">
                                    <li>Free standard delivery on orders over $150.</li>
                                    <li>Express shipping available at checkout.</li>
                                    <li>Free returns within 30 days for unworn items with tags attached.</li>
                                </ul>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Quantity Selector Logic
        function incrementQty() {
            const input = document.getElementById('quantity');
            input.value = parseInt(input.value) + 1;
        }

        function decrementQty() {
            const input = document.getElementById('quantity');
            if (parseInt(input.value) > 1) {
                input.value = parseInt(input.value) - 1;
            }
        }

        // Vanilla JS Accordion Logic
        document.addEventListener('DOMContentLoaded', () => {
            const toggles = document.querySelectorAll('.accordion-toggle');

            toggles.forEach(toggle => {
                toggle.addEventListener('click', () => {
                    const content = toggle.nextElementSibling;
                    const icon = toggle.querySelector('.accordion-icon');

                    // Toggle visibility
                    if (content.classList.contains('hidden')) {
                        content.classList.remove('hidden');
                        content.classList.add('block');
                        icon.textContent = 'remove'; // Change + to -
                    } else {
                        content.classList.remove('block');
                        content.classList.add('hidden');
                        icon.textContent = 'add'; // Change - to +
                    }
                });
            });
        });
    </script>
}