@model Ecommerce.Models.ViewModels.ProductDetailsVM

@{
    ViewData["Title"] = Model.Name;

    var mainImage = Model.Images != null && Model.Images.Any()
        ? Model.Images.First().ImagePath
        : null;

    var sizes = new[] { "XS", "S", "M", "L", "XL", "XXL" };
}

<div class="w-full bg-background pt-24 pb-16">
    <div class="max-w-[1280px] mx-auto px-4 md:px-margin-desktop">

        <!-- Breadcrumbs -->
        <nav aria-label="Breadcrumb"
             class="flex text-xs font-bold uppercase tracking-widest text-tertiary mb-6">

            <a asp-controller="Home"
               asp-action="Index"
               class="hover:text-primary transition-colors">
                Home
            </a>

            <span class="mx-2">/</span>

            <a asp-controller="Product"
               asp-action="Index"
               class="hover:text-primary transition-colors">
                @Model.CategoryName
            </a>

            <span class="mx-2">/</span>

            <span class="text-on-surface">
                @Model.Name
            </span>
        </nav>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16">

            <!-- LEFT COLUMN: Image Gallery -->
            <div class="lg:col-span-7 flex flex-col gap-4">

                <!-- Main Image Stage (Preserves Aspect Ratio, No Cropping) -->
                <div class="w-full min-h-[380px] max-h-[620px] bg-surface-variant/40 rounded-sm overflow-hidden flex items-center justify-center relative p-2 md:p-4">

                    @if (!string.IsNullOrWhiteSpace(mainImage))
                    {
                        <img src="@mainImage"
                             alt="@Model.Name"
                             id="mainProductImage"
                             class="w-auto h-auto max-w-full max-h-[580px] object-contain rounded-sm transition-all duration-300"
                             loading="eager" />
                    }
                    else
                    {
                        <span class="font-headline-md text-tertiary uppercase tracking-widest py-32">
                            NO IMAGE
                        </span>
                    }
                </div>

                <!-- Thumbnails -->
                @if (Model.Images != null && Model.Images.Count > 1)
                {
                    <div class="grid grid-cols-4 gap-3">

                        @for (int index = 0; index < Model.Images.Count; index++)
                        {
                            var image = Model.Images[index];

                            <button type="button"
                                    onclick="changeProductImage('@image.ImagePath', this)"
                                    class="product-thumbnail aspect-square bg-surface-variant/40 border rounded-sm overflow-hidden transition-colors focus:outline-none flex items-center justify-center p-1 @(index == 0 ? "border-primary ring-2 ring-primary" : "border-outline-variant hover:border-on-surface")">

                                <img src="@image.ImagePath"
                                     alt="@Model.Name"
                                     class="w-full h-full object-contain"
                                     loading="lazy" />
                            </button>
                        }
                    </div>
                }
            </div>

            <!-- RIGHT COLUMN: Product Details -->
            <div class="lg:col-span-5 relative">
                <div class="sticky top-28 flex flex-col">

                    <!-- Category, Name, Rating and Price -->
                    <div class="border-b border-outline-variant/30 pb-6 mb-6">

                        <span class="font-label-caps text-label-caps text-primary-container mb-2 block">
                            @Model.CategoryName?.ToUpper()
                        </span>

                        <h1 class="text-3xl md:text-5xl font-black text-on-surface uppercase tracking-tight mb-4">
                            @Model.Name
                        </h1>

                        @if (Model.ReviewCount > 0)
                        {
                            <div class="flex items-center gap-2 mb-4">

                                <div class="flex items-center text-primary-container">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <span class="material-symbols-outlined text-[18px]"
                                              style="font-variation-settings: 'FILL' @(i <= Math.Round(Model.AverageRating) ? 1 : 0);">
                                            star
                                        </span>
                                    }
                                </div>

                                <a href="#reviews"
                                   class="text-sm text-tertiary hover:text-on-surface underline transition-colors">
                                    @Model.ReviewCount Review@(Model.ReviewCount == 1 ? "" : "s")
                                </a>
                            </div>
                        }

                        <p class="text-xl md:text-2xl font-medium text-on-surface mb-2">
                            @Model.Price.ToString("C")
                        </p>

                        <!-- Stock Status -->
                        @if (Model.Stock == 0)
                        {
                            <p class="font-label-caps text-label-caps text-primary-container">
                                OUT OF STOCK
                            </p>
                        }
                        else if (Model.Stock <= 5)
                        {
                            <p class="font-label-caps text-label-caps text-primary-container">
                                ONLY @Model.Stock LEFT — ORDER SOON
                            </p>
                        }
                        else
                        {
                            <p class="font-label-caps text-label-caps text-tertiary">
                                IN STOCK
                            </p>
                        }
                    </div>

                    <!-- Add to Cart -->
                    <form asp-controller="Cart"
                          asp-action="Add"
                          method="post"
                          class="flex flex-col gap-6 mb-8">

                        <input type="hidden"
                               name="productId"
                               value="@Model.Id" />

                        @if (Model.HasSizes)
                        {
                            <div>
                                <label class="text-xs font-bold uppercase tracking-widest text-on-surface mb-3 block">
                                    Select Size
                                </label>

                                <div class="flex gap-2 flex-wrap">
                                    @foreach (var size in sizes)
                                    {
                                        var isDefault = size == "M";
                                        <button type="button"
                                                onclick="selectSize(this)"
                                                data-selected="@(isDefault ? "true" : null)"
                                                class="size-btn w-12 h-12 border rounded-sm font-label-caps text-label-caps font-bold transition-all @(isDefault ? "bg-on-surface text-background border-on-surface shadow-sm" : "bg-transparent text-on-surface border-outline-variant hover:border-on-surface")">
                                            @size
                                        </button>
                                    }
                                </div>

                                <input type="hidden"
                                       name="size"
                                       id="selectedSizeInput"
                                       value="M" />
                            </div>
                        }

                        <!-- Quantity -->
                        <div class="flex flex-col gap-2">

                            <label for="quantity"
                                   class="text-xs font-bold uppercase tracking-widest text-on-surface">
                                Quantity
                            </label>

                            <div class="flex items-center border border-outline-variant rounded-sm w-32">

                                <button type="button"
                                        onclick="decrementQty()"
                                        class="px-4 py-2 text-tertiary hover:text-on-surface transition-colors focus:outline-none">
                                    -
                                </button>

                                <input type="number"
                                       id="quantity"
                                       name="quantity"
                                       value="1"
                                       min="1"
                                       max="@Model.Stock"
                                       class="w-full text-center bg-transparent border-none focus:ring-0 text-on-surface font-medium p-0" />

                                <button type="button"
                                        onclick="incrementQty()"
                                        class="px-4 py-2 text-tertiary hover:text-on-surface transition-colors focus:outline-none">
                                    +
                                </button>
                            </div>
                        </div>

                        <!-- Buttons -->
                        <div class="flex flex-col gap-3 mt-4">

                            @if (Model.Stock > 0)
                            {
                                <button type="submit"
                                        class="w-full bg-primary text-on-primary py-4 font-bold uppercase tracking-widest rounded-sm hover:bg-primary/90 transition-colors flex items-center justify-center gap-2">

                                    Add To Cart

                                    <span class="material-symbols-outlined text-[20px]">
                                        shopping_bag
                                    </span>
                                </button>
                            }
                            else
                            {
                                <button type="button"
                                        disabled
                                        class="w-full bg-gray-400 text-white py-4 font-bold uppercase tracking-widest rounded-sm cursor-not-allowed flex items-center justify-center gap-2">

                                    Out Of Stock

                                    <span class="material-symbols-outlined text-[20px]">
                                        shopping_bag
                                    </span>
                                </button>
                            }

                            <a asp-controller="Wishlist"
                               asp-action="Add"
                               asp-route-id="@Model.Id"
                               class="w-full bg-surface border border-outline-variant text-on-surface py-4 font-bold uppercase tracking-widest rounded-sm hover:bg-surface-variant transition-colors flex items-center justify-center gap-2">

                                Save to Wishlist

                                <span class="material-symbols-outlined text-[20px]">
                                    favorite_border
                                </span>
                            </a>
                        </div>
                    </form>

                    <!-- Description and Reviews -->
                    <div class="border-t border-outline-variant/30 flex flex-col"
                         id="reviews">

                        <!-- Description -->
                        <div class="border-b border-outline-variant/30">

                            <button type="button"
                                    class="accordion-toggle w-full flex items-center justify-between py-5 focus:outline-none group">

                                <span class="text-sm font-bold uppercase tracking-widest text-on-surface group-hover:text-primary transition-colors">
                                    Description
                                </span>

                                <span class="material-symbols-outlined text-tertiary group-hover:text-primary transition-colors accordion-icon">
                                    remove
                                </span>
                            </button>

                            <div class="accordion-content pb-5 text-tertiary-fixed-dim text-sm leading-relaxed block">

                                @if (!string.IsNullOrWhiteSpace(Model.Description))
                                {
                                    @Html.Raw(Model.Description)
                                }
                                else
                                {
                                    <p>
                                        Engineered for maximum performance and durability.
                                    </p>
                                }
                            </div>
                        </div>

                        <!-- Reviews -->
                        <div class="border-b border-outline-variant/30">

                            <button type="button"
                                    class="accordion-toggle w-full flex items-center justify-between py-5 focus:outline-none group">

                                <span class="text-sm font-bold uppercase tracking-widest text-on-surface group-hover:text-primary transition-colors">
                                    Reviews (@Model.ReviewCount)
                                </span>

                                <span class="material-symbols-outlined text-tertiary group-hover:text-primary transition-colors accordion-icon">
                                    add
                                </span>
                            </button>

                            <div class="accordion-content pb-5 text-tertiary-fixed-dim text-sm leading-relaxed hidden">

                                <!-- Published Reviews -->
                                @if (Model.Reviews != null && Model.Reviews.Any())
                                {
                                    <div class="flex flex-col gap-5 mb-6">

                                        @foreach (var review in Model.Reviews)
                                        {
                                            <div class="border-b border-outline-variant pb-5 last:border-0 last:pb-0">

                                                <div class="flex justify-between items-start mb-2">

                                                    <p class="font-body-md text-on-surface font-medium">
                                                        @review.UserFullName
                                                    </p>

                                                    <div class="flex items-center text-primary-container">
                                                        @for (int i = 1; i <= 5; i++)
                                                        {
                                                            <span class="material-symbols-outlined text-[14px]"
                                                                  style="font-variation-settings: 'FILL' @(i <= review.Rating ? 1 : 0);">
                                                                star
                                                            </span>
                                                        }
                                                    </div>
                                                </div>

                                                <p class="font-body-md text-sm text-tertiary mb-2">
                                                    @review.CreatedAt.ToString("MMM d, yyyy")
                                                </p>

                                                <p class="font-body-md text-body-md text-on-surface">
                                                    @review.Text
                                                </p>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <p class="mb-4">
                                        No reviews yet. Be the first to review this gear.
                                    </p>
                                }

                                <!-- Add Review -->
                                @if (User.Identity != null && User.Identity.IsAuthenticated)
                                {
                                    <form asp-controller="Comment"
                                          asp-action="Add"
                                          method="post"
                                          class="bg-surface-container-low border border-outline-variant rounded-sm p-4 mt-4">

                                        <input type="hidden"
                                               name="ProductId"
                                               value="@Model.Id" />

                                        <div class="mb-4">

                                            <label class="font-label-caps text-label-caps text-tertiary mb-2 block">
                                                YOUR RATING
                                            </label>

                                            <div class="star-rating"
                                                 role="radiogroup"
                                                 aria-label="Choose your rating">

                                                @for (int rating = 5; rating >= 1; rating--)
                                                {
                                                    <input type="radio"
                                                           id="rating@rating"
                                                           name="Rating"
                                                           value="@rating"
                                                           required="@(rating == 5 ? "required" : null)" />

                                                    <label for="rating@rating"
                                                           title="@rating star rating"
                                                           aria-label="@rating stars">
                                                        ★
                                                    </label>
                                                }
                                            </div>
                                        </div>

                                        <label class="font-label-caps text-label-caps text-tertiary mb-2 block">
                                            YOUR REVIEW
                                        </label>

                                        <textarea name="Text"
                                                  class="input-field w-full bg-surface text-on-surface border border-outline-variant p-2 rounded-sm mb-3 focus:ring-primary focus:border-primary"
                                                  rows="3"
                                                  maxlength="1000"
                                                  placeholder="Share your thoughts..."
                                                  required></textarea>

                                        <button type="submit"
                                                class="w-full bg-primary-container text-on-primary font-label-caps text-label-caps px-6 py-3 rounded-sm hover:opacity-90 transition-opacity">
                                            SUBMIT REVIEW
                                        </button>

                                        <p class="font-label-caps text-label-caps text-tertiary mt-2">
                                            Reviews are published after admin approval.
                                        </p>
                                    </form>
                                }
                                else
                                {
                                    <div class="bg-surface-container-low border border-outline-variant rounded-sm p-4 text-center mt-4">

                                        <p class="text-on-surface text-sm">

                                            <a asp-controller="Account"
                                               asp-action="Login"
                                               class="text-primary-container font-bold hover:underline">
                                                Sign in
                                            </a>

                                            to leave a review.
                                        </p>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .star-rating {
        display: inline-flex;
        flex-direction: row-reverse;
        justify-content: flex-end;
        gap: 5px;
    }

    .star-rating input {
        position: absolute;
        width: 1px;
        height: 1px;
        opacity: 0;
        pointer-events: none;
    }

    .star-rating label {
        margin: 0;
        color: #c9cdd2;
        font-size: 36px;
        line-height: 1;
        cursor: pointer;
        user-select: none;
        transition: color 0.2s ease, transform 0.2s ease;
    }

    .star-rating label:hover,
    .star-rating label:hover ~ label,
    .star-rating input:checked ~ label {
        color: #f4b400;
    }

    .star-rating label:hover {
        transform: scale(1.12);
    }

    .star-rating input:focus-visible + label {
        outline: 2px solid #f4b400;
        outline-offset: 3px;
        border-radius: 2px;
    }
</style>

@section Scripts {
    <script>
        // Change Main Product Image
        function changeProductImage(imagePath, button) {
            const mainImage = document.getElementById("mainProductImage");
            if (mainImage) {
                mainImage.src = imagePath;
            }

            document.querySelectorAll(".product-thumbnail")
                .forEach(function(thumbnail) {
                    thumbnail.classList.remove("border-primary", "ring-2", "ring-primary");
                    thumbnail.classList.add("border-outline-variant");
                });

            button.classList.remove("border-outline-variant");
            button.classList.add("border-primary", "ring-2", "ring-primary");
        }

        // Size Selection (Semantic Theme Adaptive)
        function selectSize(button) {
            const activeClasses = ["bg-on-surface", "text-background", "border-on-surface", "shadow-sm"];
            const inactiveClasses = ["bg-transparent", "text-on-surface", "border-outline-variant"];

            document.querySelectorAll(".size-btn")
                .forEach(function(sizeButton) {
                    sizeButton.classList.remove(...activeClasses);
                    sizeButton.classList.add(...inactiveClasses);
                    sizeButton.removeAttribute("data-selected");
                });

            button.classList.remove(...inactiveClasses);
            button.classList.add(...activeClasses);
            button.setAttribute("data-selected", "true");

            const hiddenInput = document.getElementById("selectedSizeInput");
            if (hiddenInput) {
                hiddenInput.value = button.textContent.trim();
            }
        }

        // Quantity
        function incrementQty() {
            const input = document.getElementById("quantity");
            if (!input) return;

            const currentValue = parseInt(input.value) || 1;
            const maximumValue = parseInt(input.max) || currentValue + 1;

            if (currentValue < maximumValue) {
                input.value = currentValue + 1;
            }
        }

        function decrementQty() {
            const input = document.getElementById("quantity");
            if (!input) return;

            const currentValue = parseInt(input.value) || 1;
            if (currentValue > 1) {
                input.value = currentValue - 1;
            }
        }

        document.addEventListener("DOMContentLoaded", function() {
            // Accordion toggles
            const toggles = document.querySelectorAll(".accordion-toggle");
            toggles.forEach(function(toggle) {
                toggle.addEventListener("click", function() {
                    const content = toggle.nextElementSibling;
                    const icon = toggle.querySelector(".accordion-icon");

                    if (content.classList.contains("hidden")) {
                        content.classList.remove("hidden");
                        content.classList.add("block");
                        if (icon) icon.textContent = "remove";
                    } else {
                        content.classList.remove("block");
                        content.classList.add("hidden");
                        if (icon) icon.textContent = "add";
                    }
                });
            });
        });
    </script>
}
