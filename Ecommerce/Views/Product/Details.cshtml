@model Ecommerce.Models.ViewModels.ProductDetailsVM
@{
    ViewData["Title"] = Model.Name;
    var mainImage = Model.Images != null && Model.Images.Any() ? Model.Images.First().ImagePath : null;
}

<div class="w-full max-w-[1280px] mx-auto px-margin-mobile md:px-margin-desktop py-section-padding">

    <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-sm text-tertiary mb-6">
        <a asp-controller="Home" asp-action="Index" class="hover:text-on-surface">Home</a>
        <span>/</span>
        <a asp-controller="Product" asp-action="Index" class="hover:text-on-surface">@Model.CategoryName</a>
        <span>/</span>
        <span class="text-on-surface">@Model.Name</span>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-gutter">
        <!-- Gallery -->
        <div>
            <div class="aspect-square bg-surface-container-low border border-outline-variant rounded-sm overflow-hidden mb-4">
                @if (!string.IsNullOrEmpty(mainImage))
                {
                    <img class="w-full h-full object-cover" src="@mainImage" alt="@Model.Name" id="mainProductImage" />
                }
                else
                {
                    <div class="w-full h-full flex items-center justify-center text-tertiary font-label-caps text-label-caps">NO IMAGE</div>
                }
            </div>
            @if (Model.Images != null && Model.Images.Count > 1)
            {
                <div class="grid grid-cols-4 gap-3">
                    @foreach (var img in Model.Images)
                    {
                        <button type="button" onclick="document.getElementById('mainProductImage').src='@img.ImagePath'"
                                class="aspect-square bg-surface-container-low border border-outline-variant rounded-sm overflow-hidden">
                            <img class="w-full h-full object-cover" src="@img.ImagePath" alt="@Model.Name" />
                        </button>
                    }
                </div>
            }
        </div>

        <!-- Info Panel -->
        <div>
            <span class="font-label-caps text-label-caps text-primary-container mb-2 block">@Model.CategoryName?.ToUpper()</span>
            <h1 class="font-display-lg-mobile text-display-lg-mobile text-on-surface mb-4">@Model.Name</h1>

            @if (Model.ReviewCount > 0)
            {
                <div class="flex items-center gap-2 mb-4">
                    <div class="flex items-center text-primary-container">
                        @for (int i = 1; i <= 5; i++)
                        {
                            <span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' @(i <= Math.Round(Model.AverageRating) ? 1 : 0);">star</span>
                        }
                    </div>
                    <a href="#reviews" class="text-sm text-tertiary hover:text-on-surface underline transition-colors">@Model.ReviewCount Review@(Model.ReviewCount == 1 ? "" : "s")</a>
                </div>
            }

            <span class="font-price-display text-price-display text-on-surface block mb-4">@Model.Price.ToString("C")</span>

            @if (Model.HasSizes)
            {
                <div class="mb-6">
                    <label class="font-label-caps text-label-caps text-tertiary mb-2 block">SELECT SIZE</label>
                    <div class="flex gap-2">
                        <button type="button" onclick="selectSize(this)" class="size-btn w-12 h-12 border border-outline-variant rounded-sm font-label-caps text-label-caps text-on-surface hover:border-on-surface transition-colors">XS</button>
                        <button type="button" onclick="selectSize(this)" class="size-btn w-12 h-12 border border-outline-variant rounded-sm font-label-caps text-label-caps text-on-surface hover:border-on-surface transition-colors">S</button>
                        <button type="button" onclick="selectSize(this)" class="size-btn w-12 h-12 border border-outline-variant rounded-sm font-label-caps text-label-caps text-on-surface hover:border-on-surface transition-colors" data-selected="true">M</button>
                        <button type="button" onclick="selectSize(this)" class="size-btn w-12 h-12 border border-outline-variant rounded-sm font-label-caps text-label-caps text-on-surface hover:border-on-surface transition-colors">L</button>
                        <button type="button" onclick="selectSize(this)" class="size-btn w-12 h-12 border border-outline-variant rounded-sm font-label-caps text-label-caps text-on-surface hover:border-on-surface transition-colors">XL</button>
                        <button type="button" onclick="selectSize(this)" class="size-btn w-12 h-12 border border-outline-variant rounded-sm font-label-caps text-label-caps text-on-surface hover:border-on-surface transition-colors">XXL</button>
                    </div>
                </div>
            }

            @if (Model.Stock == 0)
            {
                <p class="font-label-caps text-label-caps text-primary-container mb-6">OUT OF STOCK</p>
            }
            else if (Model.Stock <= 5)
            {
                <p class="font-label-caps text-label-caps text-primary-container mb-6">ONLY @Model.Stock LEFT — ORDER SOON</p>
            }
            else
            {
                <p class="font-label-caps text-label-caps text-tertiary mb-6">IN STOCK</p>
            }

            <p class="font-body-md text-body-md text-tertiary mb-8">@Model.Description</p>

            <div class="flex gap-3 mb-8">
                <form asp-controller="Cart" asp-action="Add" method="post" class="flex-1">
                    <input type="hidden" name="productId" value="@Model.Id" />
                    <input type="hidden" name="quantity" value="1" />
                    @if (Model.HasSizes)
                    {
                        <input type="hidden" name="size" id="selectedSizeInput" value="M" />
                    }
                    <button type="submit" class="w-full bg-primary-container text-on-primary font-label-caps text-label-caps px-10 py-4 rounded-sm hover:bg-surface-tint transition-all flex items-center justify-center gap-2" @(Model.Stock == 0 ? "disabled" : "")>
                        <span class="material-symbols-outlined text-[18px]">shopping_cart</span>
                        ADD TO CART
                    </button>
                </form>
                <form asp-controller="Wishlist" asp-action="Add" method="post">
                    <input type="hidden" name="productId" value="@Model.Id" />
                    <button type="submit" class="w-14 h-14 border border-outline-variant rounded-sm flex items-center justify-center hover:border-on-surface transition-colors">
                        <span class="material-symbols-outlined">favorite</span>
                    </button>
                </form>
            </div>

            <div class="border-t border-outline-variant pt-6" id="reviews">
                <div class="flex border-b border-outline-variant mb-6">
                    <button class="flex-1 py-4 font-label-caps text-label-caps text-on-surface border-b-2 border-on-surface">Description</button>
                    <button class="flex-1 py-4 font-label-caps text-label-caps text-tertiary">Reviews (@Model.ReviewCount)</button>
                </div>

                @if (Model.Reviews != null && Model.Reviews.Any())
                {
                    <div class="flex flex-col gap-5 mb-8">
                        @foreach (var r in Model.Reviews)
                        {
                            <div class="border-b border-outline-variant pb-5">
                                <div class="flex justify-between items-start mb-2">
                                    <p class="font-body-md text-on-surface font-medium">@r.UserFullName</p>
                                    <div class="flex items-center text-primary-container">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            <span class="material-symbols-outlined text-[14px]" style="font-variation-settings: 'FILL' @(i <= r.Rating ? 1 : 0);">star</span>
                                        }
                                    </div>
                                </div>
                                <p class="font-body-md text-sm text-tertiary mb-2">@r.CreatedAt.ToString("MMM d, yyyy")</p>
                                <p class="font-body-md text-body-md text-on-surface">@r.Text</p>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="w-full text-center py-8 border border-dashed border-outline-variant rounded-sm mb-8">
                        <span class="material-symbols-outlined text-tertiary text-[24px] mb-1 block">rate_review</span>
                        <p class="font-body-md text-sm text-tertiary">No reviews yet — be the first to leave one.</p>
                    </div>
                }

                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <form asp-controller="Comment" asp-action="Add" method="post" class="bg-surface-container-low rounded p-5">
                        <input type="hidden" name="ProductId" value="@Model.Id" />
                        <label class="font-label-caps text-label-caps text-tertiary mb-2 block">YOUR RATING</label>
                        <select name="Rating" class="input-field mb-3" style="max-width:120px;">
                            <option value="5">5 - Excellent</option>
                            <option value="4">4 - Good</option>
                            <option value="3">3 - Average</option>
                            <option value="2">2 - Poor</option>
                            <option value="1">1 - Terrible</option>
                        </select>
                        <label class="font-label-caps text-label-caps text-tertiary mb-2 block">YOUR REVIEW</label>
                        <textarea name="Text" class="input-field mb-3" rows="3" placeholder="Share your thoughts on this product..." required></textarea>
                        <button type="submit" class="bg-primary-container text-on-primary font-label-caps text-label-caps px-6 py-3 rounded hover:opacity-90 transition-opacity">
                            SUBMIT REVIEW
                        </button>
                        <p class="font-label-caps text-label-caps text-tertiary mt-2">Reviews are published after admin approval.</p>
                    </form>
                }
                else
                {
                    <div class="bg-surface-container-low rounded p-5 text-center">
                        <p class="font-body-md text-body-md text-on-surface">
                            <a asp-controller="Account" asp-action="Login" class="text-primary-container font-bold">Sign in</a> to leave a review.
                        </p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function selectSize(btn) {
            document.querySelectorAll('.size-btn').forEach(b => {
                b.classList.remove('border-on-surface', 'bg-on-surface', 'text-on-primary');
                b.classList.add('border-outline-variant', 'text-on-surface');
                b.removeAttribute('data-selected');
            });
            btn.classList.remove('border-outline-variant', 'text-on-surface');
            btn.classList.add('border-on-surface', 'bg-on-surface', 'text-on-primary');
            btn.setAttribute('data-selected', 'true');

            var hiddenInput = document.getElementById('selectedSizeInput');
            if (hiddenInput) {
                hiddenInput.value = btn.textContent.trim();
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            const selected = document.querySelector('.size-btn[data-selected="true"]');
            if (selected) {
                selected.classList.remove('border-outline-variant', 'text-on-surface');
                selected.classList.add('border-on-surface', 'bg-on-surface', 'text-on-primary');
            }
        });
    </script>
}