@model Ecommerce.Models.ViewModels.ProductDetailsVM

@{
    ViewData["Title"] = Model.Name;

    var sizes = new[] { "XS", "S", "M", "L", "XL", "XXL" };
}

<div class="w-full bg-background pt-16 md:pt-20 pb-24">
    <div class="w-full max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">

        <!-- Breadcrumbs -->
        <nav aria-label="Breadcrumb" class="flex text-xs font-bold uppercase tracking-widest text-tertiary mb-6">
            <a asp-controller="Home" asp-action="Index" class="hover:text-primary transition-colors">Home</a>
            <span class="mx-2">/</span>
            <a asp-controller="Product" asp-action="Index" class="hover:text-primary transition-colors">@Model.CategoryName</a>
            <span class="mx-2">/</span>
            <span class="text-on-surface truncate">@Model.Name</span>
        </nav>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">

            <!-- LEFT COLUMN: Primary Image As-Is + Clickable Gallery Slider -->
            <div class="lg:col-span-7 flex flex-col gap-4">
                @if (Model.Images != null && Model.Images.Any())
                {
                    var firstImage = Model.Images.First();

                    <!-- Main First Image (Displayed As-Is, Uncropped) -->
                    <div class="w-full overflow-hidden rounded-sm bg-surface-container-low border border-outline-variant/40 shadow-sm">
                        <img src="@firstImage.ImagePath"
                             alt="@Model.Name"
                             id="mainProductImage"
                             class="w-full h-auto object-cover block transition-all duration-300"
                             loading="eager" />
                    </div>

                    <!-- Clickable Slider for Remaining Images -->
                    @if (Model.Images.Count > 1)
                    {
                        <div class="relative w-full group/gallerySlider mt-1">
                            <div id="productThumbnailsSlider" class="flex overflow-x-auto gap-3 pb-2 hide-scrollbar scroll-smooth items-center">
                                @for (int index = 0; index < Model.Images.Count; index++)
                                {
                                    var image = Model.Images[index];
                                    <button type="button"
                                            onclick="changeProductImage('@image.ImagePath', this)"
                                            class="product-thumbnail shrink-0 w-20 h-20 md:w-24 md:h-24 aspect-square rounded-sm overflow-hidden border bg-surface-container-low transition-all focus:outline-none @(index == 0 ? "border-primary ring-2 ring-primary" : "border-outline-variant/60 hover:border-on-surface")"
                                            aria-label="View photo @(index + 1)">
                                        <img src="@image.ImagePath"
                                             alt="@Model.Name - Thumbnail @(index + 1)"
                                             class="w-full h-full object-cover block"
                                             loading="lazy" />
                                    </button>
                                }
                            </div>

                            @if (Model.Images.Count > 3)
                            {
                                <button type="button"
                                        onclick="slideThumbnails(-1)"
                                        class="absolute -left-3 top-1/2 -translate-y-1/2 w-8 h-8 rounded-full bg-surface border border-outline-variant text-on-surface flex items-center justify-center shadow-md hover:bg-surface-variant hover:border-primary transition-all focus:outline-none z-10"
                                        aria-label="Previous thumbnails">
                                    <span class="material-symbols-outlined text-[18px]">chevron_left</span>
                                </button>
                                <button type="button"
                                        onclick="slideThumbnails(1)"
                                        class="absolute -right-3 top-1/2 -translate-y-1/2 w-8 h-8 rounded-full bg-surface border border-outline-variant text-on-surface flex items-center justify-center shadow-md hover:bg-surface-variant hover:border-primary transition-all focus:outline-none z-10"
                                        aria-label="Next thumbnails">
                                    <span class="material-symbols-outlined text-[18px]">chevron_right</span>
                                </button>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="w-full aspect-[3/4] bg-surface-container-low border border-outline-variant rounded-sm flex items-center justify-center text-tertiary font-label-caps text-sm">
                        NO IMAGE AVAILABLE
                    </div>
                }
            </div>

            <!-- RIGHT COLUMN: Gymshark-Style Sticky Product Details & Actions -->
            <div class="lg:col-span-5 relative">
                <div class="sticky top-24 flex flex-col gap-6">

                    <!-- Header: Category, Title, Ratings & Price -->
                    <div class="border-b border-outline-variant/30 pb-6">
                        <span class="text-xs font-bold uppercase tracking-widest text-primary mb-2 block">
                            @Model.CategoryName
                        </span>

                        <h1 class="text-2xl md:text-4xl font-black text-on-surface uppercase tracking-tight mb-3">
                            @Model.Name
                        </h1>

                        <div class="flex items-center justify-between mb-4">
                            <span class="text-2xl md:text-3xl font-black text-on-surface tracking-tight">
                                @Model.Price.ToString("C")
                            </span>

                            @if (Model.ReviewCount > 0)
                            {
                                <a href="#reviews" class="flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-tertiary hover:text-primary transition-colors">
                                    <div class="flex text-primary text-[14px]">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            <span class="material-symbols-outlined text-[15px]" style="font-variation-settings: 'FILL' @(i <= Math.Round(Model.AverageRating) ? 1 : 0);">
                                                star
                                            </span>
                                        }
                                    </div>
                                    <span>(@Model.ReviewCount)</span>
                                </a>
                            }
                        </div>

                        <!-- Stock Status -->
                        @if (Model.Stock == 0)
                        {
                            <span class="inline-block bg-primary/10 text-primary font-bold text-xs uppercase tracking-wider px-3 py-1 rounded-sm">
                                Out of Stock
                            </span>
                        }
                        else if (Model.Stock <= 5)
                        {
                            <span class="inline-block bg-amber-500/10 text-amber-500 font-bold text-xs uppercase tracking-wider px-3 py-1 rounded-sm">
                                Only @Model.Stock left in stock
                            </span>
                        }
                        else
                        {
                            <span class="inline-block bg-emerald-500/10 text-emerald-500 font-bold text-xs uppercase tracking-wider px-3 py-1 rounded-sm">
                                In Stock &amp; Ready to Ship
                            </span>
                        }
                    </div>

                    <!-- Add to Cart Form -->
                    <form asp-controller="Cart" asp-action="Add" method="post" class="flex flex-col gap-6">
                        <input type="hidden" name="productId" value="@Model.Id" />
                        <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />

                        @if (Model.HasSizes)
                        {
                            <div>
                                <div class="flex justify-between items-center mb-3">
                                    <label class="text-xs font-bold uppercase tracking-widest text-on-surface">
                                        Select Size
                                    </label>
                                    <span class="text-[11px] font-semibold text-tertiary uppercase tracking-wider">
                                        True to size
                                    </span>
                                </div>

                                <div class="grid grid-cols-6 gap-2">
                                    @foreach (var size in sizes)
                                    {
                                        <button type="button"
                                                onclick="selectSize(this)"
                                                data-selected="@(size == "M" ? "true" : null)"
                                                class="size-btn py-3 border border-outline-variant rounded-sm font-bold text-xs uppercase tracking-wider text-on-surface hover:border-primary transition-all">
                                            @size
                                        </button>
                                    }
                                </div>

                                <input type="hidden" name="size" id="selectedSizeInput" value="M" />
                            </div>
                        }

                        <!-- Quantity Selector -->
                        <div class="flex items-center justify-between">
                            <label for="quantity" class="text-xs font-bold uppercase tracking-widest text-on-surface">
                                Quantity
                            </label>

                            <div class="flex items-center border border-outline-variant rounded-sm bg-surface">
                                <button type="button" onclick="decrementQty()" class="px-3.5 py-2 text-tertiary hover:text-on-surface transition-colors focus:outline-none font-bold">
                                    -
                                </button>
                                <input type="number"
                                       id="quantity"
                                       name="quantity"
                                       value="1"
                                       min="1"
                                       max="@Model.Stock"
                                       class="w-12 text-center bg-transparent border-none focus:ring-0 text-on-surface font-bold text-sm p-0" />
                                <button type="button" onclick="incrementQty()" class="px-3.5 py-2 text-tertiary hover:text-on-surface transition-colors focus:outline-none font-bold">
                                    +
                                </button>
                            </div>
                        </div>

                        <!-- Add to Bag CTA Button -->
                        <div>
                            @if (Model.Stock > 0)
                            {
                                <button type="submit"
                                        class="w-full bg-primary text-on-primary py-4 font-black uppercase tracking-widest text-sm rounded-sm hover:bg-primary/90 transition-all flex items-center justify-center gap-2 shadow-sm">
                                    <span class="material-symbols-outlined text-[20px]">shopping_bag</span>
                                    Add to Bag
                                </button>
                            }
                            else
                            {
                                <button type="button"
                                        disabled
                                        class="w-full bg-surface-container-low text-tertiary py-4 font-bold uppercase tracking-widest text-sm rounded-sm cursor-not-allowed border border-outline-variant">
                                    Out of Stock
                                </button>
                            }
                        </div>
                    </form>

                    <!-- Save to Wishlist -->
                    <form asp-controller="Wishlist" asp-action="Add" method="post" class="w-full">
                        <input type="hidden" name="productId" value="@Model.Id" />
                        <button type="submit"
                                class="w-full bg-surface border border-outline-variant text-on-surface py-3.5 font-bold uppercase tracking-wider text-xs rounded-sm hover:bg-surface-variant hover:border-primary transition-all flex items-center justify-center gap-2">
                            <span class="material-symbols-outlined text-[18px]">favorite_border</span>
                            Add to Wishlist
                        </button>
                    </form>

                    <!-- Gymshark PDP Reassurance Strip -->
                    <div class="grid grid-cols-2 gap-3 py-4 border-y border-outline-variant/30 text-xs">
                        <div class="flex items-center gap-2 text-tertiary">
                            <span class="material-symbols-outlined text-primary text-[20px]">local_shipping</span>
                            <span>Free Express Delivery over $75</span>
                        </div>
                        <div class="flex items-center gap-2 text-tertiary">
                            <span class="material-symbols-outlined text-primary text-[20px]">cycle</span>
                            <span>Free 30-Day Returns</span>
                        </div>
                    </div>

                    <!-- Collapsible Accordions (Description & Reviews) -->
                    <div class="flex flex-col border-b border-outline-variant/30" id="reviews">

                        <!-- Accordion: Description -->
                        <div class="border-t border-outline-variant/30">
                            <button type="button" class="accordion-toggle w-full flex items-center justify-between py-4 focus:outline-none group">
                                <span class="text-xs font-bold uppercase tracking-widest text-on-surface group-hover:text-primary transition-colors">
                                    Description &amp; Fit
                                </span>
                                <span class="material-symbols-outlined text-tertiary group-hover:text-primary transition-colors accordion-icon">
                                    remove
                                </span>
                            </button>
                            <div class="accordion-content pb-5 text-tertiary text-sm leading-relaxed block">
                                @if (!string.IsNullOrWhiteSpace(Model.Description))
                                {
                                    @Html.Raw(Model.Description)
                                }
                                else
                                {
                                    <p>Engineered for relentless gym performance and uncompromised comfort. Designed with sweat-wicking materials and four-way stretch construction.</p>
                                }
                            </div>
                        </div>

                        <!-- Accordion: Reviews -->
                        <div class="border-t border-outline-variant/30">
                            <button type="button" class="accordion-toggle w-full flex items-center justify-between py-4 focus:outline-none group">
                                <span class="text-xs font-bold uppercase tracking-widest text-on-surface group-hover:text-primary transition-colors">
                                    Reviews (@Model.ReviewCount)
                                </span>
                                <span class="material-symbols-outlined text-tertiary group-hover:text-primary transition-colors accordion-icon">
                                    add
                                </span>
                            </button>
                            <div class="accordion-content pb-5 text-tertiary text-sm leading-relaxed hidden">

                                <!-- Published Reviews -->
                                @if (Model.Reviews != null && Model.Reviews.Any())
                                {
                                    <div class="flex flex-col gap-4 mb-6">
                                        @foreach (var review in Model.Reviews)
                                        {
                                            <div class="border-b border-outline-variant/40 pb-4 last:border-0 last:pb-0">
                                                <div class="flex justify-between items-start mb-1">
                                                    <p class="text-on-surface font-bold text-sm">@review.UserFullName</p>
                                                    <div class="flex items-center text-primary">
                                                        @for (int i = 1; i <= 5; i++)
                                                        {
                                                            <span class="material-symbols-outlined text-[14px]" style="font-variation-settings: 'FILL' @(i <= review.Rating ? 1 : 0);">
                                                                star
                                                            </span>
                                                        }
                                                    </div>
                                                </div>
                                                <p class="text-xs text-tertiary mb-2">@review.CreatedAt.ToString("MMM d, yyyy")</p>
                                                <p class="text-on-surface text-sm">@review.Text</p>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <p class="mb-4 text-xs text-tertiary">No reviews yet. Be the first verified athlete to review this gear.</p>
                                }

                                <!-- Add Review Section -->
                                @if (User.Identity != null && User.Identity.IsAuthenticated)
                                {
                                    @if (Model.IsEligibleToReview)
                                    {
                                        <form asp-controller="Comment" asp-action="Add" method="post" class="bg-surface-container-low border border-outline-variant rounded-sm p-4 mt-2">
                                            <input type="hidden" name="ProductId" value="@Model.Id" />

                                            <div class="mb-3">
                                                <label class="text-xs font-bold uppercase tracking-wider text-tertiary mb-1.5 block">
                                                    Your Rating
                                                </label>
                                                <div class="star-rating" role="radiogroup" aria-label="Choose your rating">
                                                    @for (int rating = 5; rating >= 1; rating--)
                                                    {
                                                        <input type="radio" id="rating@rating" name="Rating" value="@rating" required="@(rating == 5 ? "required" : null)" />
                                                        <label for="rating@rating" title="@rating star rating" aria-label="@rating stars">★</label>
                                                    }
                                                </div>
                                            </div>

                                            <label class="text-xs font-bold uppercase tracking-wider text-tertiary mb-1.5 block">
                                                Your Review
                                            </label>
                                            <textarea name="Text" class="w-full bg-surface text-on-surface border border-outline-variant p-3 rounded-sm text-sm mb-3 focus:ring-1 focus:ring-primary focus:border-primary outline-none" rows="3" maxlength="1000" placeholder="Share your experience..." required></textarea>

                                            <button type="submit" class="w-full bg-primary text-on-primary py-3 font-bold uppercase tracking-widest text-xs rounded-sm hover:bg-primary/90 transition-colors">
                                                Submit Review
                                            </button>
                                            <p class="text-[11px] text-tertiary mt-2 text-center">Reviews are published after admin approval.</p>
                                        </form>
                                    }
                                    else
                                    {
                                        <div class="bg-surface-container-low border border-outline-variant/60 rounded-sm p-4 mt-2 text-center">
                                            <div class="w-8 h-8 rounded-full bg-primary/10 text-primary flex items-center justify-center mx-auto mb-2">
                                                <span class="material-symbols-outlined text-[18px]">verified</span>
                                            </div>
                                            <p class="text-on-surface text-xs font-bold mb-1">Verified Purchase Required</p>
                                            <p class="text-tertiary text-xs">
                                                Only verified buyers who have purchased and received this product can leave a review.
                                            </p>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="bg-surface-container-low border border-outline-variant rounded-sm p-4 text-center mt-2">
                                        <p class="text-on-surface text-xs">
                                            <a asp-controller="Account" asp-action="Login" class="text-primary font-bold hover:underline">Sign in</a> to leave a review.
                                        </p>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<style>
    .star-rating {
        display: inline-flex;
        flex-direction: row-reverse;
        justify-content: flex-end;
        gap: 5px;
    }
    .star-rating input {
        position: absolute;
        width: 1px;
        height: 1px;
        opacity: 0;
        pointer-events: none;
    }
    .star-rating label {
        margin: 0;
        color: #c9cdd2;
        font-size: 28px;
        line-height: 1;
        cursor: pointer;
        user-select: none;
        transition: color 0.2s ease, transform 0.2s ease;
    }
    .star-rating label:hover,
    .star-rating label:hover ~ label,
    .star-rating input:checked ~ label {
        color: #f4b400;
    }
    .star-rating label:hover {
        transform: scale(1.12);
    }
    .star-rating input:focus-visible + label {
        outline: 2px solid #f4b400;
        outline-offset: 3px;
        border-radius: 2px;
    }
</style>

@section Scripts {
    <script>
        // Change Main Product Image from Slider
        function changeProductImage(imagePath, button) {
            const mainImage = document.getElementById("mainProductImage");
            if (mainImage) {
                mainImage.src = imagePath;
            }

            document.querySelectorAll(".product-thumbnail").forEach(function (thumbnail) {
                thumbnail.classList.remove("border-primary", "ring-2", "ring-primary");
                thumbnail.classList.add("border-outline-variant/60");
            });

            if (button) {
                button.classList.remove("border-outline-variant/60");
                button.classList.add("border-primary", "ring-2", "ring-primary");
            }
        }

        // Slide Thumbnails horizontally
        function slideThumbnails(direction) {
            const slider = document.getElementById("productThumbnailsSlider");
            if (!slider) return;
            slider.scrollBy({ left: direction * 180, behavior: "smooth" });
        }

        // Size Selection
        function selectSize(button) {
            document.querySelectorAll(".size-btn").forEach(function (sizeButton) {
                sizeButton.classList.remove("border-primary", "bg-primary", "text-on-primary");
                sizeButton.classList.add("border-outline-variant", "text-on-surface");
                sizeButton.removeAttribute("data-selected");
            });

            button.classList.remove("border-outline-variant", "text-on-surface");
            button.classList.add("border-primary", "bg-primary", "text-on-primary");
            button.setAttribute("data-selected", "true");

            const hiddenInput = document.getElementById("selectedSizeInput");
            if (hiddenInput) {
                hiddenInput.value = button.textContent.trim();
            }
        }

        // Quantity controls
        function incrementQty() {
            const input = document.getElementById("quantity");
            if (!input) return;
            const currentValue = parseInt(input.value) || 1;
            const maximumValue = parseInt(input.max) || currentValue + 1;
            if (currentValue < maximumValue) {
                input.value = currentValue + 1;
            }
        }

        function decrementQty() {
            const input = document.getElementById("quantity");
            if (!input) return;
            const currentValue = parseInt(input.value) || 1;
            if (currentValue > 1) {
                input.value = currentValue - 1;
            }
        }

        document.addEventListener("DOMContentLoaded", function () {
            // Initial selected size
            const selectedSize = document.querySelector('.size-btn[data-selected="true"]');
            if (selectedSize) {
                selectedSize.classList.remove("border-outline-variant", "text-on-surface");
                selectedSize.classList.add("border-primary", "bg-primary", "text-on-primary");
            }

            // Accordion toggles
            const toggles = document.querySelectorAll(".accordion-toggle");
            toggles.forEach(function (toggle) {
                toggle.addEventListener("click", function () {
                    const content = toggle.nextElementSibling;
                    const icon = toggle.querySelector(".accordion-icon");

                    if (content.classList.contains("hidden")) {
                        content.classList.remove("hidden");
                        content.classList.add("block");
                        if (icon) icon.textContent = "remove";
                    } else {
                        content.classList.remove("block");
                        content.classList.add("hidden");
                        if (icon) icon.textContent = "add";
                    }
                });
            });
        });
    </script>
}