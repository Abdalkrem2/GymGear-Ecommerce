@model Ecommerce.Models.ViewModels.ProductDetailsVM

@{
    ViewData["Title"] = Model.Name;

    var mainImage = Model.Images != null && Model.Images.Any()
        ? Model.Images.First().ImagePath
        : null;
}

<div class="w-full bg-background pt-24 pb-16">
    <div class="max-w-[1280px] mx-auto px-4 md:px-margin-desktop">

        <!-- Breadcrumbs -->
        <nav aria-label="Breadcrumb"
             class="flex text-xs font-bold uppercase tracking-widest text-tertiary mb-6">

            <a asp-controller="Home"
               asp-action="Index"
               class="hover:text-primary transition-colors">
                Home
            </a>

            <span class="mx-2">/</span>

            <a asp-controller="Product"
               asp-action="Index"
               class="hover:text-primary transition-colors">
                @Model.CategoryName
            </a>

            <span class="mx-2">/</span>

            <span class="text-on-surface">
                @Model.Name
            </span>
        </nav>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16">

            <!-- LEFT COLUMN: Image Gallery -->
            <div class="lg:col-span-7 flex flex-col gap-4">

                <!-- Main Image -->
                <div class="w-full bg-surface-container-low aspect-[4/5] rounded-sm overflow-hidden flex items-center justify-center relative">

                    @if (!string.IsNullOrEmpty(mainImage))
                    {
                        <img src="@mainImage"
                             alt="@Model.Name"
                             id="mainProductImage"
                             class="w-full h-full object-cover" />
                    }
                    else
                    {
                        <span class="font-headline-md text-tertiary uppercase tracking-widest">
                            NO IMAGE
                        </span>
                    }

                </div>

                <!-- Thumbnails -->
                @if (Model.Images != null && Model.Images.Count > 1)
                {
                    <div class="grid grid-cols-4 gap-3">

                        @foreach (var img in Model.Images)
                        {
                            <button type="button"
                                    onclick="document.getElementById('mainProductImage').src='@img.ImagePath'"
                                    class="aspect-square bg-surface-container-low border border-outline-variant rounded-sm overflow-hidden hover:border-on-surface transition-colors focus:outline-none">

                                <img class="w-full h-full object-cover"
                                     src="@img.ImagePath"
                                     alt="@Model.Name" />
                            </button>
                        }

                    </div>
                }

            </div>

            <!-- RIGHT COLUMN: Product Details -->
            <div class="lg:col-span-5 relative">

                <div class="sticky top-28 flex flex-col">

                    <!-- Category, Title and Price -->
                    <div class="border-b border-outline-variant/30 pb-6 mb-6">

                        <span class="font-label-caps text-label-caps text-primary-container mb-2 block">
                            @Model.CategoryName?.ToUpper()
                        </span>

                        <h1 class="text-3xl md:text-5xl font-black text-on-surface uppercase tracking-tight mb-4">
                            @Model.Name
                        </h1>

                        @if (Model.ReviewCount > 0)
                        {
                            <div class="flex items-center gap-2 mb-4">

                                <div class="flex items-center text-primary-container">

                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <span class="material-symbols-outlined text-[18px]"
                                              style="font-variation-settings: 'FILL' @(i <= Math.Round(Model.AverageRating) ? 1 : 0);">
                                            star
                                        </span>
                                    }

                                </div>

                                <a href="#reviews"
                                   class="text-sm text-tertiary hover:text-on-surface underline transition-colors">
                                    @Model.ReviewCount Review@(Model.ReviewCount == 1 ? "" : "s")
                                </a>

                            </div>
                        }

                        <p class="text-xl md:text-2xl font-medium text-on-surface mb-2">
                            @Model.Price.ToString("C")
                        </p>

                        <!-- Stock Status -->
                        @if (Model.Stock == 0)
                        {
                            <p class="font-label-caps text-label-caps text-primary-container">
                                OUT OF STOCK
                            </p>
                        }
                        else if (Model.Stock <= 5)
                        {
                            <p class="font-label-caps text-label-caps text-primary-container">
                                ONLY @Model.Stock LEFT — ORDER SOON
                            </p>
                        }
                        else
                        {
                            <p class="font-label-caps text-label-caps text-tertiary">
                                IN STOCK
                            </p>
                        }

                    </div>

                    <!-- Add to Cart Form -->
                    <form asp-controller="Cart"
                          asp-action="Add"
                          method="post"
                          class="flex flex-col gap-6 mb-8">

                        <input type="hidden"
                               name="productId"
                               value="@Model.Id" />

                        @if (Model.HasSizes)
                        {
                            <div>

                                <label class="text-xs font-bold uppercase tracking-widest text-on-surface mb-3 block">
                                    Select Size
                                </label>

                                <div class="flex gap-2 flex-wrap">

                                    <button type="button"
                                            onclick="selectSize(this)"
                                            class="size-btn w-12 h-12 border border-outline-variant rounded-sm font-label-caps text-label-caps text-on-surface hover:border-on-surface transition-colors">
                                        XS
                                    </button>

                                    <button type="button"
                                            onclick="selectSize(this)"
                                            class="size-btn w-12 h-12 border border-outline-variant rounded-sm font-label-caps text-label-caps text-on-surface hover:border-on-surface transition-colors">
                                        S
                                    </button>

                                    <button type="button"
                                            onclick="selectSize(this)"
                                            data-selected="true"
                                            class="size-btn w-12 h-12 border border-outline-variant rounded-sm font-label-caps text-label-caps text-on-surface hover:border-on-surface transition-colors">
                                        M
                                    </button>

                                    <button type="button"
                                            onclick="selectSize(this)"
                                            class="size-btn w-12 h-12 border border-outline-variant rounded-sm font-label-caps text-label-caps text-on-surface hover:border-on-surface transition-colors">
                                        L
                                    </button>

                                    <button type="button"
                                            onclick="selectSize(this)"
                                            class="size-btn w-12 h-12 border border-outline-variant rounded-sm font-label-caps text-label-caps text-on-surface hover:border-on-surface transition-colors">
                                        XL
                                    </button>

                                    <button type="button"
                                            onclick="selectSize(this)"
                                            class="size-btn w-12 h-12 border border-outline-variant rounded-sm font-label-caps text-label-caps text-on-surface hover:border-on-surface transition-colors">
                                        XXL
                                    </button>

                                </div>

                                <input type="hidden"
                                       name="size"
                                       id="selectedSizeInput"
                                       value="M" />

                            </div>
                        }

                        <!-- Quantity -->
                        <div class="flex flex-col gap-2">

                            <label for="quantity"
                                   class="text-xs font-bold uppercase tracking-widest text-on-surface">
                                Quantity
                            </label>

                            <div class="flex items-center border border-outline-variant rounded-sm w-32">

                                <button type="button"
                                        onclick="decrementQty()"
                                        class="px-4 py-2 text-tertiary hover:text-on-surface transition-colors focus:outline-none">
                                    -
                                </button>

                                <input type="number"
                                       id="quantity"
                                       name="quantity"
                                       value="1"
                                       min="1"
                                       class="w-full text-center bg-transparent border-none focus:ring-0 text-on-surface font-medium p-0" />

                                <button type="button"
                                        onclick="incrementQty()"
                                        class="px-4 py-2 text-tertiary hover:text-on-surface transition-colors focus:outline-none">
                                    +
                                </button>

                            </div>
                        </div>

                        <!-- Buttons -->
                        <div class="flex flex-col gap-3 mt-4">

                            <button type="submit"
                                    class="w-full bg-primary text-on-primary py-4 font-bold uppercase tracking-widest rounded-sm hover:bg-primary/90 transition-colors flex items-center justify-center gap-2"
                                    disabled="@(Model.Stock == 0 ? "disabled" : null)">

                                Add To Cart

                                <span class="material-symbols-outlined text-[20px]">
                                    shopping_bag
                                </span>

                            </button>

                            <a asp-controller="Wishlist"
                               asp-action="Add"
                               asp-route-id="@Model.Id"
                               class="w-full bg-surface border border-outline-variant text-on-surface py-4 font-bold uppercase tracking-widest rounded-sm hover:bg-surface-variant transition-colors flex items-center justify-center gap-2">

                                Save to Wishlist

                                <span class="material-symbols-outlined text-[20px]">
                                    favorite_border
                                </span>

                            </a>

                        </div>
                    </form>

                    <!-- Description and Reviews -->
                    <div class="border-t border-outline-variant/30 flex flex-col"
                         id="reviews">

                        <!-- Description -->
                        <div class="border-b border-outline-variant/30">

                            <button type="button"
                                    class="accordion-toggle w-full flex items-center justify-between py-5 focus:outline-none group">

                                <span class="text-sm font-bold uppercase tracking-widest text-on-surface group-hover:text-primary transition-colors">
                                    Description
                                </span>

                                <span class="material-symbols-outlined text-tertiary group-hover:text-primary transition-colors accordion-icon">
                                    remove
                                </span>

                            </button>

                            <div class="accordion-content pb-5 text-tertiary-fixed-dim text-sm leading-relaxed block">

                                @if (!string.IsNullOrEmpty(Model.Description))
                                {
                                    @Html.Raw(Model.Description)
                                }
                                else
                                {
                                    <p>
                                        Engineered for maximum performance and durability.
                                    </p>
                                }

                            </div>
                        </div>

                        <!-- Reviews -->
                        <div class="border-b border-outline-variant/30">

                            <button type="button"
                                    class="accordion-toggle w-full flex items-center justify-between py-5 focus:outline-none group">

                                <span class="text-sm font-bold uppercase tracking-widest text-on-surface group-hover:text-primary transition-colors">
                                    Reviews (@Model.ReviewCount)
                                </span>

                                <span class="material-symbols-outlined text-tertiary group-hover:text-primary transition-colors accordion-icon">
                                    add
                                </span>

                            </button>

                            <div class="accordion-content pb-5 text-tertiary-fixed-dim text-sm leading-relaxed hidden">

                                <!-- Published Reviews -->
                                @if (Model.Reviews != null && Model.Reviews.Any())
                                {
                                    <div class="flex flex-col gap-5 mb-6">

                                        @foreach (var review in Model.Reviews)
                                        {
                                            <div class="border-b border-outline-variant pb-5 last:border-0 last:pb-0">

                                                <div class="flex justify-between items-start mb-2">

                                                    <p class="font-body-md text-on-surface font-medium">
                                                        @review.UserFullName
                                                    </p>

                                                    <div class="flex items-center text-primary-container">

                                                        @for (int i = 1; i <= 5; i++)
                                                        {
                                                            <span class="material-symbols-outlined text-[14px]"
                                                                  style="font-variation-settings: 'FILL' @(i <= review.Rating ? 1 : 0);">
                                                                star
                                                            </span>
                                                        }

                                                    </div>
                                                </div>

                                                <p class="font-body-md text-sm text-tertiary mb-2">
                                                    @review.CreatedAt.ToString("MMM d, yyyy")
                                                </p>

                                                <p class="font-body-md text-body-md text-on-surface">
                                                    @review.Text
                                                </p>

                                            </div>
                                        }

                                    </div>
                                }
                                else
                                {
                                    <p class="mb-4">
                                        No reviews yet. Be the first to review this gear.
                                    </p>
                                }

                                <!-- Add Review Form -->
                                @if (User.Identity != null && User.Identity.IsAuthenticated)
                                {
                                    <form asp-controller="Comment"
                                          asp-action="Add"
                                          method="post"
                                          class="bg-surface-container-low border border-outline-variant rounded-sm p-4 mt-4">

                                        <input type="hidden"
                                               name="ProductId"
                                               value="@Model.Id" />

                                        <!-- Star Rating -->
                                        <div class="mb-4">

                                            <label class="font-label-caps text-label-caps text-tertiary mb-2 block">
                                                YOUR RATING
                                            </label>

                                            <div class="star-rating"
                                                 role="radiogroup"
                                                 aria-label="Choose your rating">

                                                <input type="radio"
                                                       id="rating5"
                                                       name="Rating"
                                                       value="5"
                                                       required />

                                                <label for="rating5"
                                                       title="Excellent"
                                                       aria-label="5 stars">
                                                    ★
                                                </label>

                                                <input type="radio"
                                                       id="rating4"
                                                       name="Rating"
                                                       value="4" />

                                                <label for="rating4"
                                                       title="Good"
                                                       aria-label="4 stars">
                                                    ★
                                                </label>

                                                <input type="radio"
                                                       id="rating3"
                                                       name="Rating"
                                                       value="3" />

                                                <label for="rating3"
                                                       title="Average"
                                                       aria-label="3 stars">
                                                    ★
                                                </label>

                                                <input type="radio"
                                                       id="rating2"
                                                       name="Rating"
                                                       value="2" />

                                                <label for="rating2"
                                                       title="Poor"
                                                       aria-label="2 stars">
                                                    ★
                                                </label>

                                                <input type="radio"
                                                       id="rating1"
                                                       name="Rating"
                                                       value="1" />

                                                <label for="rating1"
                                                       title="Terrible"
                                                       aria-label="1 star">
                                                    ★
                                                </label>

                                            </div>
                                        </div>

                                        <!-- Review Text -->
                                        <label class="font-label-caps text-label-caps text-tertiary mb-2 block">
                                            YOUR REVIEW
                                        </label>

                                        <textarea name="Text"
                                                  class="input-field w-full bg-surface text-on-surface border border-outline-variant p-2 rounded-sm mb-3 focus:ring-primary focus:border-primary"
                                                  rows="3"
                                                  maxlength="1000"
                                                  placeholder="Share your thoughts..."
                                                  required></textarea>

                                        <button type="submit"
                                                class="w-full bg-primary-container text-on-primary font-label-caps text-label-caps px-6 py-3 rounded-sm hover:opacity-90 transition-opacity">
                                            SUBMIT REVIEW
                                        </button>

                                        <p class="font-label-caps text-label-caps text-tertiary mt-2">
                                            Reviews are published after admin approval.
                                        </p>

                                    </form>
                                }
                                else
                                {
                                    <div class="bg-surface-container-low border border-outline-variant rounded-sm p-4 text-center mt-4">

                                        <p class="text-on-surface text-sm">

                                            <a asp-controller="Account"
                                               asp-action="Login"
                                               class="text-primary-container font-bold hover:underline">
                                                Sign in
                                            </a>

                                            to leave a review.

                                        </p>
                                    </div>
                                }

                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Star Rating Style -->
<style>
    .star-rating {
        display: inline-flex;
        flex-direction: row-reverse;
        justify-content: flex-end;
        gap: 5px;
    }

        .star-rating input {
            position: absolute;
            width: 1px;
            height: 1px;
            opacity: 0;
            pointer-events: none;
        }

        .star-rating label {
            margin: 0;
            color: #c9cdd2;
            font-size: 36px;
            line-height: 1;
            cursor: pointer;
            user-select: none;
            transition: color 0.2s ease, transform 0.2s ease;
        }

            .star-rating label:hover,
            .star-rating label:hover ~ label,
            .star-rating input:checked ~ label {
                color: #f4b400;
            }

            .star-rating label:hover {
                transform: scale(1.12);
            }

        .star-rating input:focus-visible + label {
            outline: 2px solid #f4b400;
            outline-offset: 3px;
            border-radius: 2px;
        }
</style>

@section Scripts {
    <script>
        // Size Selection
        function selectSize(button) {
            document.querySelectorAll(".size-btn").forEach(function(sizeButton) {
                sizeButton.classList.remove(
                    "border-on-surface",
                    "bg-on-surface",
                    "text-on-primary"
                );

                sizeButton.classList.add(
                    "border-outline-variant",
                    "text-on-surface"
                );

                sizeButton.removeAttribute("data-selected");
            });

            button.classList.remove(
                "border-outline-variant",
                "text-on-surface"
            );

            button.classList.add(
                "border-on-surface",
                "bg-on-surface",
                "text-on-primary"
            );

            button.setAttribute("data-selected", "true");

            const hiddenInput =
                document.getElementById("selectedSizeInput");

            if (hiddenInput) {
                hiddenInput.value = button.textContent.trim();
            }
        }

        // Quantity
        function incrementQty() {
            const input = document.getElementById("quantity");

            if (input) {
                const currentValue = parseInt(input.value) || 1;
                input.value = currentValue + 1;
            }
        }

        function decrementQty() {
            const input = document.getElementById("quantity");

            if (input) {
                const currentValue = parseInt(input.value) || 1;

                if (currentValue > 1) {
                    input.value = currentValue - 1;
                }
            }
        }

        document.addEventListener("DOMContentLoaded", function() {

            // Default Selected Size
            const selectedSize =
                document.querySelector('.size-btn[data-selected="true"]');

            if (selectedSize) {
                selectedSize.classList.remove(
                    "border-outline-variant",
                    "text-on-surface"
                );

                selectedSize.classList.add(
                    "border-on-surface",
                    "bg-on-surface",
                    "text-on-primary"
                );
            }

            // Accordion
            const toggles =
                document.querySelectorAll(".accordion-toggle");

            toggles.forEach(function(toggle) {
                toggle.addEventListener("click", function() {
                    const content = toggle.nextElementSibling;
                    const icon =
                        toggle.querySelector(".accordion-icon");

                    if (content.classList.contains("hidden")) {
                        content.classList.remove("hidden");
                        content.classList.add("block");

                        if (icon) {
                            icon.textContent = "remove";
                        }
                    }
                    else {
                        content.classList.remove("block");
                        content.classList.add("hidden");

                        if (icon) {
                            icon.textContent = "add";
                        }
                    }
                });
            });
        });
    </script>
}