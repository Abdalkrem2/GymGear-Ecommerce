@model Ecommerce.Models.ViewModels.LoginVM
@{
    ViewData["Title"] = "Sign In";
}

<section class="w-full bg-background min-h-[75vh] flex items-center justify-center px-4 py-16">
    <div class="w-full max-w-[440px] bg-surface border border-outline-variant rounded-sm p-8 md:p-10 shadow-sm">
        <h1 class="text-2xl md:text-3xl font-black uppercase tracking-tight text-on-surface mb-2">
            Sign in to your account
        </h1>
        <p class="text-sm font-medium text-tertiary mb-8">
            Welcome back — enter your details below.
        </p>

        <form asp-controller="Account" asp-action="Login" method="post" class="flex flex-col gap-5">
            <div asp-validation-summary="ModelOnly" class="text-primary font-bold text-xs uppercase tracking-wider"></div>

            <div>
                <label asp-for="Email" class="text-xs font-bold uppercase tracking-widest text-on-surface mb-2 block">
                    Email Address
                </label>
                <input asp-for="Email" 
                       class="w-full bg-surface text-on-surface border border-outline-variant placeholder:text-tertiary p-3.5 rounded-sm text-sm focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all" 
                       placeholder="you@example.com" 
                       autocomplete="email" />
                <span asp-validation-for="Email" class="text-primary text-xs font-semibold block mt-1"></span>
            </div>

            <div>
                <label asp-for="Password" class="text-xs font-bold uppercase tracking-widest text-on-surface mb-2 block">
                    Password
                </label>
                <input asp-for="Password" 
                       type="password"
                       class="w-full bg-surface text-on-surface border border-outline-variant placeholder:text-tertiary p-3.5 rounded-sm text-sm focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all" 
                       placeholder="••••••••" 
                       autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-primary text-xs font-semibold block mt-1"></span>
            </div>

            <div class="flex justify-between items-center text-xs">
                <label class="flex items-center gap-2 font-medium text-on-surface cursor-pointer select-none">
                    <input asp-for="RememberMe" class="rounded-sm border-outline-variant bg-surface text-primary focus:ring-primary h-4 w-4" /> 
                    Remember me
                </label>
                <a href="#" class="font-bold uppercase tracking-wider text-tertiary hover:text-primary transition-colors">
                    Forgot Password?
                </a>
            </div>

            <button type="submit" class="w-full bg-primary text-on-primary py-4 font-bold uppercase tracking-widest rounded-sm hover:bg-primary/90 transition-colors mt-2">
                Sign In
            </button>
        </form>

        <div class="relative my-8 text-center">
            <div class="absolute inset-0 flex items-center">
                <div class="w-full border-t border-outline-variant/50"></div>
            </div>
            <span class="relative bg-surface px-4 text-xs font-bold uppercase tracking-widest text-tertiary">
                Or
            </span>
        </div>

        <div class="text-center text-sm text-tertiary">
            Don't have an account? 
            <a asp-controller="Account" asp-action="Register" class="text-primary font-bold hover:underline ml-1">
                Create one
            </a>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

