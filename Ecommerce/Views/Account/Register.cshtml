@model Ecommerce.Models.ViewModels.RegisterVM
@{
    ViewData["Title"] = "Create Account";
}

<div class="w-full min-h-screen flex flex-col lg:flex-row bg-background">

    <!-- LEFT COLUMN: Lifestyle Hero Media with Clean Subtle Seam -->
    <div class="hidden lg:flex lg:w-1/2 relative min-h-screen overflow-hidden select-none bg-neutral-950">
        
        <!-- Crossfading Lifestyle Images with Ken Burns Animation -->
        <div class="absolute inset-0 z-0 animate-kenburns">
            <img src="https://images.unsplash.com/photo-1534438327276-14e5300c3a48?auto=format&fit=crop&w=1600&q=85"
                 alt="Gym Training Collective"
                 class="hero-carousel-slide absolute inset-0 w-full h-full object-cover filter brightness-95 transition-opacity duration-1000 ease-in-out opacity-100" />
            <img src="https://images.unsplash.com/photo-1517838277536-f5f99be501cd?auto=format&fit=crop&w=1600&q=85"
                 alt="Athlete Knurling Preparation"
                 class="hero-carousel-slide absolute inset-0 w-full h-full object-cover filter brightness-95 transition-opacity duration-1000 ease-in-out opacity-0" />
            <img src="https://images.unsplash.com/photo-1581009146145-b5ef050c2e1e?auto=format&fit=crop&w=1600&q=85"
                 alt="High Intensity Conditioning"
                 class="hero-carousel-slide absolute inset-0 w-full h-full object-cover filter brightness-95 transition-opacity duration-1000 ease-in-out opacity-0" />

            <!-- Dark Bottom & Top Gradients for Contrast -->
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-black/40"></div>
        </div>

        <!-- Subtle Crisp Edge Blend (Narrower & Cleaner) -->
        <div class="absolute inset-y-0 right-0 w-12 lg:w-16 bg-gradient-to-r from-transparent to-surface/60 dark:to-surface pointer-events-none z-10 hidden lg:block"></div>

        <!-- Left Column Athlete Manifesto -->
        <div class="relative z-20 flex flex-col justify-end p-12 xl:p-16 w-full text-white">
            <!-- Animated Slide Indicator Bars -->
            <div class="flex items-center gap-2 mb-6">
                <div class="carousel-bar h-1 w-8 rounded-full bg-primary transition-all duration-500"></div>
                <div class="carousel-bar h-1 w-2 rounded-full bg-white/30 transition-all duration-500"></div>
                <div class="carousel-bar h-1 w-2 rounded-full bg-white/30 transition-all duration-500"></div>
            </div>

            <div class="space-y-4 max-w-lg">
                <div class="text-xs font-bold uppercase tracking-[0.25em] text-primary">
                    Join The Collective
                </div>
                <h2 class="text-3xl xl:text-4xl font-black uppercase tracking-tight text-white leading-tight">
                    Elevate your training standards today.
                </h2>
                <p class="text-white/70 text-sm leading-relaxed">
                    Create an account to gain priority dispatch on all orders, seamless order telemetry, and 30-day hassle-free returns.
                </p>
            </div>
        </div>
    </div>

    <!-- RIGHT COLUMN: Solid Surface Form Column with Subtle Ambient Glow -->
    <div class="w-full lg:w-1/2 min-h-screen bg-surface flex flex-col justify-between p-6 sm:p-10 md:p-14 lg:p-16 relative overflow-hidden">
        <!-- Floating Ambient Aura Glows -->
        <div class="absolute -top-32 -right-32 w-96 h-96 bg-primary/5 dark:bg-primary/10 rounded-full blur-3xl pointer-events-none animate-aura"></div>
        <div class="absolute -bottom-32 -left-32 w-96 h-96 bg-amber-500/5 dark:bg-amber-500/10 rounded-full blur-3xl pointer-events-none animate-aura" style="animation-delay: -4s;"></div>

        <!-- Top Controls: Logo (Left) & Theme Toggle (Right) -->
        <div class="w-full flex items-center justify-between z-30 mb-6">
            <a asp-controller="Home" asp-action="Index" class="inline-flex items-center gap-2.5 font-black text-2xl tracking-tighter text-on-surface hover:text-primary transition-colors group select-none">
                <span class="p-1.5 rounded bg-primary text-on-primary flex items-center justify-center shadow-sm group-hover:scale-110 transition-transform">
                    <span class="material-symbols-outlined text-[18px]">bolt</span>
                </span>
                <span>GYM<span class="text-primary">GEAR</span></span>
            </a>

            <button type="button" id="theme-toggle" class="w-10 h-10 inline-flex items-center justify-center rounded-full bg-surface-container-high/80 hover:bg-surface-container-highest border border-outline-variant text-on-surface hover:text-primary transition-all focus:outline-none shadow-sm hover:rotate-12" title="Toggle theme">
                <span class="material-symbols-outlined text-[20px] block dark:hidden">dark_mode</span>
                <span class="material-symbols-outlined text-[20px] hidden dark:block">light_mode</span>
            </button>
        </div>

        <!-- Form Center Container -->
        <div class="auth-card-enter w-full max-w-[420px] mx-auto my-auto py-2 relative z-20">

            <!-- Back to Storefront Link -->
            <a asp-controller="Home" asp-action="Index" class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-widest text-tertiary hover:text-primary transition-colors mb-5 group">
                <span class="material-symbols-outlined text-[16px] group-hover:-translate-x-1 transition-transform">arrow_back</span>
                <span>Back to storefront</span>
            </a>

            <div class="mb-5">
                <h1 class="text-3xl sm:text-4xl font-black uppercase tracking-tight text-on-surface mb-1.5">
                    Create Account
                </h1>
                <p class="text-xs sm:text-sm text-tertiary">
                    Join GymGear to unlock express checkout and athlete benefits.
                </p>
            </div>

            <form asp-controller="Account" asp-action="Register" method="post" class="space-y-3.5">
                <div asp-validation-summary="ModelOnly" class="p-3 bg-primary/10 border border-primary/30 rounded-md text-primary font-bold text-xs uppercase tracking-wider"></div>

                <!-- Full Name Floating Label -->
                <div class="relative">
                    <input asp-for="FullName"
                           id="floating_name"
                           type="text"
                           placeholder=" "
                           class="peer block w-full px-4 pt-6 pb-2 text-sm text-on-surface bg-surface-container-low dark:bg-surface-container-lowest border border-outline-variant rounded-md focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary placeholder-transparent transition-all"
                           autocomplete="name" />
                    <label for="floating_name"
                           class="absolute text-[11px] font-bold uppercase tracking-wider text-tertiary duration-200 transform -translate-y-3 scale-90 top-4 z-10 origin-[0] left-4 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-placeholder-shown:text-xs peer-focus:scale-90 peer-focus:-translate-y-3 peer-focus:text-primary pointer-events-none">
                        Full Name
                    </label>
                    <span asp-validation-for="FullName" class="text-primary text-xs font-semibold block mt-1"></span>
                </div>

                <!-- Email Floating Label -->
                <div class="relative">
                    <input asp-for="Email"
                           id="floating_reg_email"
                           type="email"
                           placeholder=" "
                           class="peer block w-full px-4 pt-6 pb-2 text-sm text-on-surface bg-surface-container-low dark:bg-surface-container-lowest border border-outline-variant rounded-md focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary placeholder-transparent transition-all"
                           autocomplete="email" />
                    <label for="floating_reg_email"
                           class="absolute text-[11px] font-bold uppercase tracking-wider text-tertiary duration-200 transform -translate-y-3 scale-90 top-4 z-10 origin-[0] left-4 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-placeholder-shown:text-xs peer-focus:scale-90 peer-focus:-translate-y-3 peer-focus:text-primary pointer-events-none">
                        Email Address
                    </label>
                    <span asp-validation-for="Email" class="text-primary text-xs font-semibold block mt-1"></span>
                </div>

                <!-- Password Floating Label with Toggle & Live Strength Meter -->
                <div class="relative">
                    <input asp-for="Password"
                           id="floating_reg_password"
                           type="password"
                           placeholder=" "
                           oninput="checkPasswordStrength(this.value)"
                           class="peer block w-full pl-4 pr-11 pt-6 pb-2 text-sm text-on-surface bg-surface-container-low dark:bg-surface-container-lowest border border-outline-variant rounded-md focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary placeholder-transparent transition-all"
                           autocomplete="new-password" />
                    <label for="floating_reg_password"
                           class="absolute text-[11px] font-bold uppercase tracking-wider text-tertiary duration-200 transform -translate-y-3 scale-90 top-4 z-10 origin-[0] left-4 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-placeholder-shown:text-xs peer-focus:scale-90 peer-focus:-translate-y-3 peer-focus:text-primary pointer-events-none">
                        Password
                    </label>
                    <button type="button"
                            onclick="togglePasswordVisibility('floating_reg_password', this)"
                            class="absolute right-3.5 top-1/2 -translate-y-1/2 text-tertiary hover:text-on-surface focus:outline-none transition-colors"
                            aria-label="Toggle password visibility">
                        <span class="material-symbols-outlined text-[20px] block">visibility</span>
                    </button>
                </div>
                <!-- Live Password Strength Meter -->
                <div class="mt-1">
                    <div class="flex items-center gap-1.5 h-1.5 w-full bg-surface-container-low dark:bg-surface-container-lowest rounded-full overflow-hidden">
                        <div id="strengthBar" class="h-full w-0 transition-all duration-300 rounded-full"></div>
                    </div>
                    <div class="flex justify-between items-center mt-1 text-[11px]">
                        <span id="strengthText" class="font-semibold text-tertiary">Min 6 characters</span>
                        <span class="text-tertiary/70">Uppercase + Numbers</span>
                    </div>
                    <span asp-validation-for="Password" class="text-primary text-xs font-semibold block mt-0.5"></span>
                </div>

                <!-- Confirm Password Floating Label with Toggle -->
                <div class="relative">
                    <input asp-for="ConfirmPassword"
                           id="floating_confirm_password"
                           type="password"
                           placeholder=" "
                           class="peer block w-full pl-4 pr-11 pt-6 pb-2 text-sm text-on-surface bg-surface-container-low dark:bg-surface-container-lowest border border-outline-variant rounded-md focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary placeholder-transparent transition-all"
                           autocomplete="new-password" />
                    <label for="floating_confirm_password"
                           class="absolute text-[11px] font-bold uppercase tracking-wider text-tertiary duration-200 transform -translate-y-3 scale-90 top-4 z-10 origin-[0] left-4 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-placeholder-shown:text-xs peer-focus:scale-90 peer-focus:-translate-y-3 peer-focus:text-primary pointer-events-none">
                        Confirm Password
                    </label>
                    <button type="button"
                            onclick="togglePasswordVisibility('floating_confirm_password', this)"
                            class="absolute right-3.5 top-1/2 -translate-y-1/2 text-tertiary hover:text-on-surface focus:outline-none transition-colors"
                            aria-label="Toggle password visibility">
                        <span class="material-symbols-outlined text-[20px] block">visibility</span>
                    </button>
                    <span asp-validation-for="ConfirmPassword" class="text-primary text-xs font-semibold block mt-1"></span>
                </div>

                <!-- Submit CTA Button with Kinetic Shine Sweep -->
                <button type="submit"
                        class="btn-shine-sweep w-full bg-primary text-on-primary py-4 font-black uppercase tracking-widest text-sm rounded-md hover:bg-primary/90 hover:shadow-lg hover:shadow-primary/20 active:scale-[0.99] transition-all flex items-center justify-center gap-2 group mt-2">
                    <span>Create Account</span>
                    <span class="material-symbols-outlined text-[18px] group-hover:translate-x-1 transition-transform">bolt</span>
                </button>
            </form>

            <!-- Switch to Login -->
            <div class="mt-6 pt-5 border-t border-outline-variant/40 text-center">
                <p class="text-xs text-tertiary">
                    Already a member?
                    <a asp-controller="Account" asp-action="Login" class="font-bold text-on-surface hover:text-primary underline ml-1 transition-colors">
                        Sign in instead
                    </a>
                </p>
            </div>
        </div>

        <!-- Footer Copyright -->
        <div class="text-center text-[11px] text-tertiary pt-6 select-none relative z-20">
            &copy; @DateTime.Now.Year GYMGEAR ACTIVEWEAR. Built for high performance.
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePasswordVisibility(inputId, btn) {
            const input = document.getElementById(inputId);
            const icon = btn.querySelector('.material-symbols-outlined');
            if (!input || !icon) return;

            if (input.type === 'password') {
                input.type = 'text';
                icon.textContent = 'visibility_off';
            } else {
                input.type = 'password';
                icon.textContent = 'visibility';
            }
        }

        function checkPasswordStrength(password) {
            const bar = document.getElementById("strengthBar");
            const text = document.getElementById("strengthText");
            if (!bar || !text) return;

            if (!password) {
                bar.style.width = "0%";
                bar.className = "h-full w-0 transition-all duration-300 rounded-full";
                text.textContent = "Min 6 characters";
                text.className = "font-semibold text-tertiary";
                return;
            }

            let score = 0;
            if (password.length >= 6) score += 25;
            if (password.length >= 10) score += 25;
            if (/[A-Z]/.test(password)) score += 25;
            if (/[0-9]/.test(password) || /[^a-zA-Z0-9]/.test(password)) score += 25;

            bar.style.width = score + "%";

            if (score <= 25) {
                bar.className = "h-full transition-all duration-300 rounded-full bg-red-500";
                text.textContent = "Weak password";
                text.className = "font-semibold text-red-500";
            } else if (score <= 75) {
                bar.className = "h-full transition-all duration-300 rounded-full bg-amber-500";
                text.textContent = "Good password";
                text.className = "font-semibold text-amber-500";
            } else {
                bar.className = "h-full transition-all duration-300 rounded-full bg-emerald-500";
                text.textContent = "Strong password!";
                text.className = "font-semibold text-emerald-500";
            }
        }

        // Automatic crossfading carousel with animated progress bars
        document.addEventListener("DOMContentLoaded", function () {
            let currentSlide = 0;
            const slides = document.querySelectorAll('.hero-carousel-slide');
            const bars = document.querySelectorAll('.carousel-bar');

            function updateBars(index) {
                bars.forEach((bar, i) => {
                    if (i === index) {
                        bar.className = 'carousel-bar h-1 w-8 rounded-full bg-primary transition-all duration-500';
                    } else {
                        bar.className = 'carousel-bar h-1 w-2 rounded-full bg-white/30 transition-all duration-500';
                    }
                });
            }

            if (slides.length > 1) {
                setInterval(() => {
                    slides[currentSlide].classList.remove('opacity-100');
                    slides[currentSlide].classList.add('opacity-0');
                    currentSlide = (currentSlide + 1) % slides.length;
                    slides[currentSlide].classList.remove('opacity-0');
                    slides[currentSlide].classList.add('opacity-100');
                    updateBars(currentSlide);
                }, 4500);
            }
        });
    </script>
}



