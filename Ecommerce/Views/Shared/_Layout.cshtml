    <script>
            // Scroll dynamic background handler
            window.addEventListener('scroll', () => {
                const nav = document.getElementById('main-nav');
                const isMobileMenuOpen = !document.getElementById('mobile-menu').classList.contains('hidden');

                if (window.scrollY > 40 || isMobileMenuOpen) {
                    nav.classList.add('bg-surface', 'text-on-surface', 'border-outline-variant', 'shadow-md');
                    nav.classList.remove('bg-transparent', 'text-white', 'border-transparent');
                } else {
                    nav.classList.add('bg-transparent', 'text-white', 'border-transparent');
                    nav.classList.remove('bg-surface', 'text-on-surface', 'border-outline-variant', 'shadow-md');
                }
            });

            // Mobile menu and smooth expandable search handler
            document.addEventListener("DOMContentLoaded", () => {
                const menuToggle = document.getElementById("mobile-menu-toggle");
                const mobileMenu = document.getElementById("mobile-menu");
                const searchToggle = document.getElementById("search-toggle");
                const searchInput = document.getElementById("search-input");
                const searchContainer = document.getElementById("search-container");
                const searchIcon = document.getElementById("search-icon");
                const nav = document.getElementById('main-nav');

                // Mobile Menu Toggle
                if (menuToggle && mobileMenu) {
                    menuToggle.addEventListener("click", () => {
                        mobileMenu.classList.toggle("hidden");
                        mobileMenu.classList.toggle("flex");

                        if (window.scrollY <= 40) {
                            nav.classList.toggle('bg-surface');
                            nav.classList.toggle('text-on-surface');
                            nav.classList.toggle('text-white');
                            nav.classList.toggle('bg-transparent');
                        }
                    });
                }

                // Inline Smooth Easing Search Toggle
                if (searchToggle && searchInput) {
                    searchToggle.addEventListener("click", (e) => {
                        e.stopPropagation();
                        const isOpen = searchInput.classList.contains("w-44") || searchInput.classList.contains("sm:w-64");

                        if (isOpen) {
                            // Close search
                            closeSearch();
                        } else {
                            // Open search with easing to the left
                            searchInput.classList.remove("w-0", "opacity-0", "pointer-events-none");
                            searchInput.classList.add("w-44", "sm:w-64", "opacity-100", "px-3.5", "mr-1");
                            searchIcon.textContent = "close";
                            searchInput.focus();
                        }
                    });

                    // Close search when clicking anywhere outside
                    document.addEventListener("click", (e) => {
                        if (!searchContainer.contains(e.target)) {
                            closeSearch();
                        }
                    });

                    // Close search on Esc key
                    document.addEventListener("keydown", (e) => {
                        if (e.key === "Escape") {
                            closeSearch();
                        }
                    });
                }

                function closeSearch() {
                    if (searchInput && searchInput.classList.contains("opacity-100")) {
                        searchInput.classList.remove("w-44", "sm:w-64", "opacity-100", "px-3.5", "mr-1");
                        searchInput.classList.add("w-0", "opacity-0", "pointer-events-none");
                        searchIcon.textContent = "search";
                    }
                }
            });
    </script>

<main>
    @RenderBody()
</main>

