<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gym Gear & Activewear</title>

    <!-- Anti-flicker theme loader -->
    <script>
        if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }
    </script>

    <partial name="_TailwindHead" />
    @await RenderSectionAsync("Styles", required: false)
</head>

@{
    var controllerName = ViewContext.RouteData.Values["controller"]?.ToString();
    var actionName = ViewContext.RouteData.Values["action"]?.ToString();

    var isAccountPage =
        string.Equals(controllerName, "Account", StringComparison.OrdinalIgnoreCase) &&
        (string.Equals(actionName, "Login", StringComparison.OrdinalIgnoreCase) ||
         string.Equals(actionName, "Register", StringComparison.OrdinalIgnoreCase) ||
         string.Equals(actionName, "ForgotPassword", StringComparison.OrdinalIgnoreCase));

    var isHomePage =
        string.Equals(controllerName, "Home", StringComparison.OrdinalIgnoreCase) &&
        string.Equals(actionName, "Index", StringComparison.OrdinalIgnoreCase);

    var isAboutPage =
        string.Equals(controllerName, "Home", StringComparison.OrdinalIgnoreCase) &&
        string.Equals(actionName, "About", StringComparison.OrdinalIgnoreCase);

    var isTransparentNavPage = isHomePage || isAboutPage;

    var navbarClasses = isHomePage
        ? "bg-transparent text-white border-transparent"
        : "bg-surface text-on-surface border-outline-variant shadow-sm";

    var mainContentClasses = isHomePage 
        ? "flex-1 flex flex-col" 
        : "flex-1 flex flex-col pt-[64px] md:pt-[72px]";
}

<body class="bg-background text-on-background font-body-md antialiased overflow-x-hidden flex flex-col min-h-screen"
      data-toast-message="@TempData["ToastMessage"]"
      data-toast-type="@TempData["ToastType"]">

<div aria-hidden="true" class="hidden bg-surface text-on-surface border-outline-variant shadow-md bg-transparent text-white border-transparent w-44 sm:w-64 opacity-100 px-3.5 mr-1 w-0 opacity-0 pointer-events-none"></div>

    <!-- TopNavBar -->
    <nav id="main-nav" data-transparent-nav="@isHomePage.ToString().ToLower()" class="fixed top-0 w-full z-50 flex flex-col border-b transition-all duration-300 @navbarClasses">
        <div class="w-full px-4 md:px-8 h-[64px] md:h-[72px] flex items-center justify-between gap-4">

            <!-- Mobile Menu Toggle Button & Brand -->
            <div class="flex items-center gap-3 shrink-0">
                <button type="button" id="mobile-menu-toggle" class="md:hidden w-10 h-10 inline-flex items-center justify-center hover:text-primary hover:bg-white/10 rounded-full transition-colors focus:outline-none" aria-label="Toggle Navigation">
                    <span class="material-symbols-outlined block text-[22px] leading-none text-current" id="menu-icon">menu</span>
                </button>

                <!-- Brand Logo -->
                <a asp-controller="Home" asp-action="Index" class="font-display-lg text-display-lg tracking-tighter shrink-0 group" style="font-size:24px; line-height:1;">
                    <span class="text-current group-hover:text-primary transition-colors">GYM</span><span class="text-primary">GEAR</span>
                </a>
            </div>
            <!-- Desktop Navigation Links (Centered) -->
            <div id="desktop-nav-links" class="hidden md:flex items-center justify-center gap-8 absolute left-1/2 -translate-x-1/2  transition-opacity duration-200">
                <a asp-controller="Home" asp-action="Index" class="font-bold tracking-widest text-xs uppercase hover:text-primary transition-colors text-current">Home</a>
                <a asp-controller="Product" asp-action="Index" class="font-bold tracking-widest text-xs uppercase hover:text-primary transition-colors text-current">Shop</a>
                <a asp-controller="Home" asp-action="About" class="font-bold tracking-widest text-xs uppercase hover:text-primary transition-colors text-current">About</a>
            </div>
            <!-- Action Icons & Inline Easing Search -->
            <div class="flex items-center justify-end gap-1 sm:gap-1.5">
                @if (!isAccountPage)
                {
                    <div id="search-container" class="relative flex items-center">
                        <form asp-controller="Search" asp-action="Index" method="get" class="flex items-center m-0">
                            <input type="text"
                                   id="search-input"
                                   name="q"
                                   placeholder="Search gear…"
                                   class="w-0 opacity-0 pointer-events-none transition-all duration-300 ease-out bg-surface-variant/90 text-on-surface border border-outline-variant/60 rounded-full py-1.5 text-sm focus:outline-none focus:ring-1 focus:ring-primary placeholder:text-tertiary shadow-sm" />
                        </form>

                        <button type="button" id="search-toggle" class="w-10 h-10 inline-flex items-center justify-center hover:text-primary hover:bg-white/10 rounded-full transition-colors group focus:outline-none" title="Search">
                            <span class="material-symbols-outlined text-[22px] leading-none text-current group-hover:text-primary transition-colors" id="search-icon">search</span>
                        </button>
                    </div>
                }
<button type="button" id="theme-toggle" class="w-10 h-10 inline-flex items-center justify-center hover:bg-white/10 hover:text-primary rounded-full transition-colors text-current focus:outline-none" title="Toggle Theme">
    <span class="material-symbols-outlined text-[22px] leading-none text-current hidden dark:block">light_mode</span>
    <span class="material-symbols-outlined text-[22px] leading-none text-current block dark:hidden">dark_mode</span>
</button>


                <a asp-controller="Wishlist" asp-action="Index" class="w-10 h-10 inline-flex items-center justify-center hover:text-primary hover:bg-white/10 rounded-full transition-colors group" title="Wishlist">
                    <span class="material-symbols-outlined text-[22px] leading-none text-current group-hover:text-primary transition-colors">favorite</span>
                </a>

                <a asp-controller="Cart" asp-action="Index" class="w-10 h-10 inline-flex items-center justify-center hover:text-primary hover:bg-white/10 rounded-full transition-colors group relative" title="Shopping Cart">
                    <span class="material-symbols-outlined text-[22px] leading-none text-current group-hover:text-primary transition-colors">shopping_cart</span>
                </a>

                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <a asp-controller="Order" asp-action="Index" class="hidden sm:inline-flex w-10 h-10 items-center justify-center hover:text-primary hover:bg-white/10 rounded-full transition-colors group" title="My Orders">
                        <span class="material-symbols-outlined text-[22px] leading-none text-current group-hover:text-primary transition-colors">receipt_long</span>
                    </a>

                    <form asp-controller="Account" asp-action="Logout" method="post" class="hidden sm:inline-flex items-center m-0">
                        <button type="submit" class="w-10 h-10 inline-flex items-center justify-center hover:text-primary hover:bg-white/10 rounded-full transition-colors group focus:outline-none" title="Sign out">
                            <span class="material-symbols-outlined text-[22px] leading-none text-current group-hover:text-primary transition-colors">logout</span>
                        </button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="w-10 h-10 inline-flex items-center justify-center hover:text-primary hover:bg-white/10 rounded-full transition-colors group" title="Sign in">
                        <span class="material-symbols-outlined text-[22px] leading-none text-current group-hover:text-primary transition-colors">person</span>
                    </a>
                }
            </div>
        </div>


        <!-- Mobile Navigation Menu -->
        <div id="mobile-menu" class="hidden md:hidden flex-col border-t border-outline-variant bg-surface text-on-surface px-4 py-3 space-y-2 shadow-md absolute top-full left-0 w-full">
            <a asp-controller="Home" asp-action="Index" class="block py-2 font-medium hover:text-primary transition-colors">Home</a>
            <a asp-controller="Product" asp-action="Index" class="block py-2 font-medium hover:text-primary transition-colors">Shop</a>
            <a asp-controller="Home" asp-action="About" class="block py-2 font-medium hover:text-primary transition-colors">About</a>

            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <hr class="border-outline-variant my-2" />
                <a asp-controller="Order" asp-action="Index" class="flex items-center gap-2 py-2 font-medium hover:text-primary transition-colors">
                    <span class="material-symbols-outlined text-[20px]">receipt_long</span> My Orders
                </a>
                <form asp-controller="Account" asp-action="Logout" method="post" class="w-full">
                    <button type="submit" class="flex items-center gap-2 py-2 font-medium hover:text-primary transition-colors w-full text-left">
                        <span class="material-symbols-outlined text-[20px]">logout</span> Sign Out
                    </button>
                </form>
            }
        </div>
    </nav>

    <!-- Page Content (Pushed down automatically on non-home pages) -->
    <main class="@mainContentClasses">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="mt-auto bg-inverse-surface text-on-primary w-full border-t border-outline-variant/30">
        <div class="w-full px-4 md:px-8 py-12 md:py-16">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-10 md:gap-12">

                <!-- Brand -->
                <div class="md:col-span-2 space-y-4">
                    <a asp-controller="Home" asp-action="Index" class="font-display-lg text-xl md:text-2xl font-black text-on-primary tracking-tight block group">
                        <span class="text-on-primary group-hover:text-primary transition-colors">GYM</span><span class="text-primary">GEAR</span>
                    </a>
                    <p class="text-tertiary-fixed-dim text-sm md:text-base leading-relaxed max-w-sm">
                        Performance activewear for athletes who train without compromise. Engineered for durability, comfort, and speed.
                    </p>
                </div>

                <!-- Quick Links -->
                <div class="flex flex-col space-y-3">
                    <span class="text-xs font-bold tracking-widest text-on-primary uppercase mb-1">Quick Links</span>
                    <a asp-controller="Product" asp-action="Index" class="text-sm text-tertiary-fixed-dim hover:text-primary transition-colors">Shop All Gear</a>
                    <a asp-controller="Product" asp-action="Index" asp-route-category="mens" class="text-sm text-tertiary-fixed-dim hover:text-primary transition-colors">Shop Men</a>
                    <a asp-controller="Home" asp-action="About" class="text-sm text-tertiary-fixed-dim hover:text-primary transition-colors">About Us</a>
                    <a href="#" class="text-sm text-tertiary-fixed-dim hover:text-primary transition-colors">Shipping &amp; Delivery</a>
                    <a href="#" class="text-sm text-tertiary-fixed-dim hover:text-primary transition-colors">Returns &amp; Exchanges</a>
                    <a href="#" class="text-sm text-tertiary-fixed-dim hover:text-primary transition-colors">Contact Support</a>
                </div>

                <!-- Newsletter -->
                <div class="flex flex-col space-y-3">
                    <span class="text-xs font-bold tracking-widest text-on-primary uppercase mb-1">Stay Connected</span>
                    <p class="text-sm text-tertiary-fixed-dim">
                        Get first access to limited drops and exclusive training gear.
                    </p>
                    <form onsubmit="event.preventDefault();" class="mt-2">
                        <div class="relative flex items-center">
                            <input type="email" placeholder="Enter your email" class="w-full bg-surface-container-lowest/10 border border-outline-variant/40 rounded px-3.5 py-2.5 text-sm text-on-primary placeholder:text-tertiary focus:outline-none focus:border-primary transition-colors" />
                            <button type="submit" class="absolute right-1.5 p-1.5 text-primary hover:text-white hover:bg-primary rounded transition-colors" aria-label="Subscribe">
                                <span class="material-symbols-outlined text-[20px] block">arrow_forward</span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Copyright -->
            <div class="mt-12 pt-6 border-t border-outline-variant/20 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-tertiary">
                <div>
                    &copy; @DateTime.Now.Year GYMGEAR ACTIVEWEAR. All rights reserved.
                </div>
                <div class="flex items-center gap-6">
                    <a asp-controller="Home" asp-action="Privacy" class="hover:text-primary transition-colors">Privacy Policy</a>
                    <a href="#" class="hover:text-primary transition-colors">Terms of Service</a>
                </div>
            </div>
        </div>
    </footer>

 <!-- Navbar & Theme Scripts -->
<script>
    document.addEventListener("DOMContentLoaded", function() {
        const nav = document.getElementById("main-nav");
        const menuToggle = document.getElementById("mobile-menu-toggle");
        const mobileMenu = document.getElementById("mobile-menu");
        const searchToggle = document.getElementById("search-toggle");
        const searchInput = document.getElementById("search-input");
        const searchContainer = document.getElementById("search-container");
        const searchIcon = document.getElementById("search-icon");
        const isTransparentNavPage = nav?.dataset.transparentNav === "true";
        const heroSection = document.querySelector(".js-hero-section");
        const desktopNavLinks = document.getElementById("desktop-nav-links");

        // Theme toggling is handled by the single listener in site.js
        // (a duplicate listener used to live here, which caused the
        // "dark" class to be toggled twice per click and cancel itself out)

        function updateNavbar() {
            if (!nav || !isTransparentNavPage) return;

            const isMenuOpen = mobileMenu && !mobileMenu.classList.contains('hidden');
            const isSearchOpen = searchInput && searchInput.classList.contains('opacity-100');

            // Switch to solid once the hero section has scrolled out from
            // behind the fixed navbar (falls back to a small fixed offset
            // if a page using transparent-nav has no .js-hero-section).
            const navHeight = nav.offsetHeight || 0;
            const scrolledPastHero = heroSection
                ? heroSection.getBoundingClientRect().bottom <= navHeight
                : window.scrollY > 40;

            if (scrolledPastHero || isMenuOpen || isSearchOpen) {
                nav.classList.add("bg-surface", "text-on-surface", "border-outline-variant", "shadow-md");
                nav.classList.remove("bg-transparent", "text-white", "border-transparent");
            } else {
                nav.classList.add("bg-transparent", "text-white", "border-transparent");
                nav.classList.remove("bg-surface", "text-on-surface", "border-outline-variant", "shadow-md");
            }
        }

        if (isTransparentNavPage) {
            window.addEventListener("scroll", updateNavbar);
            updateNavbar();
        }

        // Mobile Menu Toggle
        if (menuToggle && mobileMenu) {
            menuToggle.addEventListener("click", function(e) {
                e.stopPropagation();
                mobileMenu.classList.toggle("hidden");
                mobileMenu.classList.toggle("flex");

                if (searchInput && searchInput.classList.contains("opacity-100")) {
                    closeSearch();
                }
                updateNavbar();
            });
        }

        // Inline Smooth Easing Search Toggle
        if (searchToggle && searchInput) {
            searchToggle.addEventListener("click", (e) => {
                e.stopPropagation();
                const isOpen = searchInput.classList.contains("w-44") || searchInput.classList.contains("sm:w-64");

                if (isOpen) {
                    closeSearch();
                } else {
                    searchInput.classList.remove("w-0", "opacity-0", "pointer-events-none");
                    searchInput.classList.add("w-44", "sm:w-64", "opacity-100", "px-3.5", "mr-1");
                    if(searchIcon) searchIcon.textContent = "close";
                    searchInput.focus();

                    if (mobileMenu && !mobileMenu.classList.contains("hidden")) {
                        mobileMenu.classList.add("hidden");
                        mobileMenu.classList.remove("flex");
                    }

                    updateNavbar();
                }
            });

            document.addEventListener("click", (e) => {
                if (searchContainer && !searchContainer.contains(e.target)) {
                    closeSearch();
                }
            });

            document.addEventListener("keydown", (e) => {
                if (e.key === "Escape") closeSearch();
            });
        }

        function closeSearch() {
            if (searchInput && searchInput.classList.contains("opacity-100")) {
                searchInput.classList.remove("w-44", "sm:w-64", "opacity-100", "px-3.5", "mr-1");
                searchInput.classList.add("w-0", "opacity-0", "pointer-events-none");
                if(searchIcon) searchIcon.textContent = "search";

                if (desktopNavLinks) {
                    desktopNavLinks.classList.remove("opacity-0", "pointer-events-none");
                }
                updateNavbar();
            }
        }
    });
</script>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)   <!-- Navbar & Theme Scripts -->
</body>
</html>
