    <!-- Navbar Script -->
    <script>
            document.addEventListener("DOMContentLoaded", function() {

                const nav =
                    document.getElementById("main-nav");

                const menuToggle =
                    document.getElementById("mobile-menu-toggle");

                const mobileMenu =
                    document.getElementById("mobile-menu");

                const isHomePage =
                    nav?.dataset.homePage === "true";

                function updateNavbar() {

                    if (!nav || !isHomePage) {
                        return;
                    }

                    if (window.scrollY > 40) {

                        nav.classList.add(
                            "bg-surface",
                            "text-on-surface",
                            "border-outline-variant",
                            "shadow-md"
                        );

                        nav.classList.remove(
                            "bg-transparent",
                            "text-white",
                            "border-transparent"
                        );

                    } else {

                        nav.classList.add(
                            "bg-transparent",
                            "text-white",
                            "border-transparent"
                        );

                        nav.classList.remove(
                            "bg-surface",
                            "text-on-surface",
                            "border-outline-variant",
                            "shadow-md"
                        );
                    }
                }

                window.addEventListener(
                    "scroll",
                    updateNavbar
                );

                updateNavbar();

                if (menuToggle && mobileMenu) {

                    menuToggle.addEventListener(
                        "click",
                        function() {

                            mobileMenu.classList.toggle("hidden");
                            mobileMenu.classList.toggle("flex");

                            if (
                                isHomePage &&
                                window.scrollY <= 40
                            ) {
                                nav.classList.toggle("bg-surface");
                                nav.classList.toggle("text-on-surface");
                                nav.classList.toggle("text-white");
                                nav.classList.toggle("bg-transparent");
                            }
                        }
                    );
                }
            });
    </script>

